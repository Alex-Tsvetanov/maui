---
# clang-tidy for the C++23 MAUI port.
#
# Curated from the acodcha/clang-format-tidy template (https://github.com/acodcha/clang-format-tidy,
# MIT) down to the check families that fit a cross-platform C++23 graphics/UI library. Dropped the
# domain-irrelevant / vendor-convention families: abseil, altera (FPGA), android, boost, cert
# (aliases), darwin, fuchsia, google, hicpp (aliases), linuxkernel, llvm/llvmlibc, mpi, objc,
# openmp, zircon. Kept bugprone / clang-analyzer / concurrency / cppcoreguidelines / misc /
# modernize / performance / portability / readability, minus a few checks that fight deliberate
# design choices (public data members on value types, short coordinate names like x/y/r/g/b,
# graphics magic numbers, recursion in the recursive-descent SVG parser) and the unchecked-container
# access check (per project decision: ASan/UBSan + tests cover bounds in hot paths).
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -modernize-use-trailing-return-type,
  -readability-avoid-nested-conditional-operator,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-magic-numbers,
  -portability-avoid-pragma-once
WarningsAsErrors: ''
# Gate the .cpp main files (the implementation). Flip to 'maui/graphics/.*' for a full header pass.
HeaderFilterRegex: ''
FormatStyle: file
User: ''
CheckOptions:
  - key: readability-redundant-member-init.IgnoreBaseInCopyConstructors
    value: 'true'
  # The framework's own MAUI_* macros (e.g. MAUI_REGISTER_HANDLER) are a deliberate, unavoidable
  # mechanism — self-registration needs a uniquely-named TU-scope static, which only a macro can spell.
  - key: cppcoreguidelines-macro-usage.AllowedRegexp
    value: '^MAUI_'
