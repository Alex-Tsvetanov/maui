{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "headless",
      "displayName": "Headless (in-memory backend, M0-M5)",
      "description": "Device-free backend; mirrors MAUI's *.Standard.cs. Fully unit-testable.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "MAUI_BACKEND": "headless",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "tidy",
      "inherits": "headless",
      "displayName": "clang-tidy guardrails",
      "description": "Headless build that runs clang-tidy over the library sources.",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": { "ENABLE_CLANG_TIDY": "ON" }
    },
    {
      "name": "asan-ubsan",
      "inherits": "headless",
      "displayName": "ASan + UBSan",
      "description": "AddressSanitizer + UndefinedBehaviorSanitizer (default checked build).",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": { "ENABLE_ASAN_UBSAN": "ON" }
    },
    {
      "name": "tsan",
      "inherits": "headless",
      "displayName": "ThreadSanitizer",
      "description": "Dedicated data-race lane (separate from ASan).",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": { "ENABLE_TSAN": "ON" }
    },
    {
      "name": "msan",
      "inherits": "headless",
      "displayName": "MemorySanitizer (Clang/Linux only)",
      "description": "Uninitialized-read lane. Requires Clang + instrumented libc++; NOT supported on AppleClang/macOS.",
      "binaryDir": "${sourceDir}/build/msan",
      "cacheVariables": { "ENABLE_MSAN": "ON" }
    },
    {
      "name": "apple",
      "inherits": "headless",
      "displayName": "Apple (AppKit / macOS, Obj-C++)",
      "description": "macOS backend; mirrors MAUI's per-platform partials with real NSViews (.mm + ARC).",
      "binaryDir": "${sourceDir}/build/apple",
      "cacheVariables": { "MAUI_BACKEND": "apple" }
    },
    {
      "name": "ios",
      "inherits": "headless",
      "displayName": "iOS (UIKit / simulator, Obj-C++)",
      "description": "iOS backend cross-compiled for the arm64 simulator; ctest runs the test binaries on a booted simulator via tools/ios-sim-run.sh (CMAKE_CROSSCOMPILING_EMULATOR).",
      "binaryDir": "${sourceDir}/build/ios",
      "cacheVariables": {
        "MAUI_BACKEND": "ios",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "VCPKG_TARGET_TRIPLET": "arm64-ios-simulator",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "CMAKE_CROSSCOMPILING_EMULATOR": "${sourceDir}/tools/ios-sim-run.sh"
      }
    },
    {
      "name": "maccatalyst",
      "inherits": "headless",
      "displayName": "Mac Catalyst (UIKit on macOS, Obj-C++)",
      "description": "Mac Catalyst backend: the iOS UIKit handlers + host retargeted to the macabi ABI (arm64-apple-ios26.0-macabi via cmake/maccatalyst.toolchain.cmake), running NATIVELY on macOS. Matches .NET MAUI's own macOS rendering (Catalyst) for the strict 3-way visual-parity check.",
      "binaryDir": "${sourceDir}/build/maccatalyst",
      "cacheVariables": {
        "MAUI_BACKEND": "maccatalyst",
        "VCPKG_TARGET_TRIPLET": "arm64-maccatalyst",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/maccatalyst.toolchain.cmake"
      }
    },
    {
      "name": "android",
      "inherits": "headless",
      "displayName": "Android (NDK / emulator, arm64-v8a)",
      "description": "Android backend cross-compiled with the in-SDK NDK 27.2 (LTS); ctest runs the test binaries on a headless emulator (dedicated maui-test AVD) via tools/android-emu-run.sh (CMAKE_CROSSCOMPILING_EMULATOR). ANDROID_NDK_HOME points vcpkg's android toolchain at the same NDK for the dependency builds (gtest/benchmark/pugixml under arm64-android).",
      "binaryDir": "${sourceDir}/build/android",
      "environment": {
        "ANDROID_NDK_HOME": "/opt/homebrew/share/android-commandlinetools/ndk/27.2.12479018"
      },
      "cacheVariables": {
        "MAUI_BACKEND": "android",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-34",
        "ANDROID_STL": "c++_static",
        "CMAKE_CROSSCOMPILING_EMULATOR": "${sourceDir}/tools/android-emu-run.sh"
      }
    }
  ],
  "buildPresets": [
    { "name": "headless", "configurePreset": "headless" },
    { "name": "tidy", "configurePreset": "tidy" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "msan", "configurePreset": "msan" },
    { "name": "apple", "configurePreset": "apple" },
    { "name": "ios", "configurePreset": "ios" },
    { "name": "maccatalyst", "configurePreset": "maccatalyst" },
    { "name": "android", "configurePreset": "android" }
  ],
  "testPresets": [
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "apple",
      "configurePreset": "apple",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "ios",
      "configurePreset": "ios",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "android",
      "configurePreset": "android",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    }
  ]
}
