<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Animations">
    <!-- Twin of AnimationPage.xaml: the dotnet_bot animation target above three buttons (Cancel starts
         disabled). The Clicked handlers / animation logic are omitted (structural twin). The image is
         sized 120x120 so the bot icon renders clearly at rest (mirrors the reference page's render). -->
    <StackLayout Margin="12" Spacing="12">
        <Image Source="dotnet_bot.png"
               WidthRequest="120"
               HeightRequest="120"
               HorizontalOptions="Center"
               VerticalOptions="CenterAndExpand" />
        <Button Text="Start Animation" />
        <Button Text="Start Custom Animation" />
        <Button Text="Cancel Animation" IsEnabled="false" />
    </StackLayout>
</ContentPage>
