<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Border using Layouts">
    <VerticalStackLayout Spacing="12" Padding="16">
        <Label Text="Stroke thickness: 5 / 40" />
        <Slider Minimum="0" Maximum="40" Value="5" />
        <Border Stroke="Silver" StrokeThickness="5" BackgroundColor="White" Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Grid BackgroundColor="Green" HeightRequest="30">
                <HorizontalStackLayout>
                    <BoxView Color="Red" WidthRequest="40" HeightRequest="40" />
                    <Label Text="Center" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" VerticalOptions="Center" />
                    <BoxView Color="Blue" WidthRequest="40" HeightRequest="40" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentPage>
