<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Device">
    <!-- DevicePage.xaml: a centered StackLayout of {OnPlatform}/{OnIdiom} readouts.
         The markup extensions resolve at load time; static representative text here. -->
