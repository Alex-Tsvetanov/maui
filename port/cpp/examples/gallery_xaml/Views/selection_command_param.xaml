<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Selection Changed Command Parameter">
    <!-- Twin of SelectionChangedCommandParameter.xaml: a single-selection CollectionView whose
         SelectionChangedCommand writes "Success"/"Fail" into a Result Label. At rest the Result reads
         "Pending...". note: the SelectionChangedCommand + SelectionChangedCommandParameter +
         {x:Reference}-sourced TwoWay SelectedItem bindings are interaction wiring with no markup sink at
         rest — degraded (the command is exercised in the code-first page). The 10 items' two-line cell
         (Text + Description) is flattened to a single {Binding .} label, the port's struct-cell reduction. -->
    <VerticalStackLayout Spacing="6" Padding="12">
        <Label Text="Pending..." />
        <CollectionView Header="This is the header" SelectionMode="Single">
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Item 0 — This is item 0</x:String>
                    <x:String>Item 1 — This is item 1</x:String>
                    <x:String>Item 2 — This is item 2</x:String>
                    <x:String>Item 3 — This is item 3</x:String>
                    <x:String>Item 4 — This is item 4</x:String>
                    <x:String>Item 5 — This is item 5</x:String>
                    <x:String>Item 6 — This is item 6</x:String>
                    <x:String>Item 7 — This is item 7</x:String>
                    <x:String>Item 8 — This is item 8</x:String>
                    <x:String>Item 9 — This is item 9</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Margin="6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
