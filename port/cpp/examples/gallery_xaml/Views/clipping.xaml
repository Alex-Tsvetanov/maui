<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clipping"
             BackgroundColor="Orange">
    <!-- Twin of ClippingPage: a VerticalStackLayout (Spacing 5) with a status label, a "Toggle clipping"
         button, then three horizontal rows whose Layout.IsClippedToBounds the button flips at runtime —
           Layout1: an 8-button overflow row (each 50 tall) spilling over a translucent-red BoxView, laid out
                    in a 2-column Grid (the row spans both columns; the box sits in the right column);
           Layout2: a width-100 purple-button HorizontalStackLayout on a LightBlue background;
           Layout3: a coffee-image HorizontalStackLayout on a LightBlue background (the 2nd image pushed
                    down by a top margin).
         The resting state = "Not clipping" (IsClippedToBounds default false), so the twin shows the rows
         un-clipped (the overflow visible). DEGRADES: the ToggleClip.Clicked handler + the runtime
         IsClippedToBounds/Clip changes are interactivity, omitted (resting appearance). -->
    <VerticalStackLayout Spacing="5">
        <Label Text="Not clipping" Margin="10" />
        <Button Text="Toggle clipping on horizontal stack layouts" HorizontalOptions="Center" Margin="5" />

        <!-- Layout1: the 8-button overflow row over a translucent-red overlay (a 2-column Grid) -->
        <Grid WidthRequest="400" HeightRequest="200">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
            </Grid.ColumnDefinitions>
            <StackLayout Orientation="Horizontal" Grid.ColumnSpan="2">
                <Button Text="1" Margin="1" HeightRequest="50" />
                <Button Text="2" Margin="1" HeightRequest="50" />
                <Button Text="3" Margin="1" HeightRequest="50" />
                <Button Text="4" Margin="1" HeightRequest="50" />
                <Button Text="5" Margin="1" HeightRequest="50" />
                <Button Text="6" Margin="1" HeightRequest="50" />
                <Button Text="7" Margin="1" HeightRequest="50" />
                <Button Text="8" Margin="1" HeightRequest="50" />
            </StackLayout>
            <BoxView Grid.Column="1" BackgroundColor="Red" Opacity="0.5" />
        </Grid>

        <!-- Layout2: the width-constrained purple-button row (HorizontalStackLayout) -->
        <HorizontalStackLayout WidthRequest="100" Padding="10" BackgroundColor="LightBlue">
            <Button Text="Hey" WidthRequest="50" HeightRequest="50" BackgroundColor="Purple" />
            <Button Text="Hey" WidthRequest="50" HeightRequest="50" BackgroundColor="Purple" />
            <Button Text="Hey" WidthRequest="50" HeightRequest="50" BackgroundColor="Purple" />
            <Button Text="Hey" WidthRequest="50" HeightRequest="50" BackgroundColor="Purple" />
        </HorizontalStackLayout>

        <!-- Layout3: the coffee-image row (HorizontalStackLayout) -->
        <HorizontalStackLayout HeightRequest="30" Padding="3" BackgroundColor="LightBlue">
            <Image Source="coffee.png" WidthRequest="50" HeightRequest="50" />
            <Image Source="coffee.png" WidthRequest="50" HeightRequest="50" Margin="0,20,0,0" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
