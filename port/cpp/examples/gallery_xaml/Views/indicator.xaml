<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IndicatorView">
    <!-- IndicatorView Count/ItemsSource are not settable from XAML text (loader note), so each row's dot
         count is driven programmatically at runtime; the caption + supported knobs are reproduced here. -->
    <Grid Padding="12" RowSpacing="6" ColumnSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Text="Basic" HorizontalTextAlignment="Center" Grid.Row="0" Grid.Column="0" />
        <IndicatorView Position="2" Grid.Row="0" Grid.Column="1" />

        <Label Text="Colors" HorizontalTextAlignment="Center" Grid.Row="1" Grid.Column="0" />
        <IndicatorView Position="2" SelectedIndicatorColor="Red" IndicatorColor="Blue" BackgroundColor="Yellow"
                       Grid.Row="1" Grid.Column="1" />

        <Label Text="Indicator Shape" HorizontalTextAlignment="Center" Grid.Row="2" Grid.Column="0" />
        <IndicatorView Position="2" IndicatorsShape="Square" Grid.Row="2" Grid.Column="1" />

        <Label Text="Indicator Size" HorizontalTextAlignment="Center" Grid.Row="3" Grid.Column="0" />
        <IndicatorView Position="2" IndicatorSize="15" Grid.Row="3" Grid.Column="1" />

        <Label Text="Indicator HideSingle" HorizontalTextAlignment="Center" Grid.Row="4" Grid.Column="0" />
        <IndicatorView HideSingle="True" Grid.Row="4" Grid.Column="1" />

        <Label Text="Indicator MaximumVisible -  7 of 10" HorizontalTextAlignment="Center" Grid.Row="5" Grid.Column="0" />
        <IndicatorView Position="3" MaximumVisible="7" Grid.Row="5" Grid.Column="1" />

        <Label Text="Indicator Template" HorizontalTextAlignment="Center" Grid.Row="6" Grid.Column="0" />
        <IndicatorView Position="2" IndicatorColor="Transparent" SelectedIndicatorColor="Transparent"
                       Grid.Row="6" Grid.Column="1" />

        <Label Text="Using with CarouselView" HorizontalTextAlignment="Center"
               VerticalTextAlignment="Start" Grid.Row="7" Grid.Column="0" />
        <IndicatorView IndicatorColor="LightGray" SelectedIndicatorColor="DarkGray" Grid.Row="7" Grid.Column="1" />
    </Grid>
</ContentPage>
