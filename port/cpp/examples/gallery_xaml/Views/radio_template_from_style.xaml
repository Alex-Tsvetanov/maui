<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RadioButton Template from Style">
    <!-- W16: the page's subject is a ControlTemplate applied to a templated control. The port's
         RadioButton.ControlTemplate is deferred at the control level, so — as the builder does — the
         template is hosted on a ContentView (the templated_view sibling). Each tile is a ContentView whose
         <ControlTemplate> draws the calendar tile (#F3F2F1 100x100 Border → Grid → a ContentPresenter that
         packs the developer Content letter top-left + a centered blue radio ring+dot). The checked-state
         VSM is deferred (builder too), so all three show the same static indicator. -->
    <StackLayout Padding="16" Spacing="8">
        <ContentView HorizontalOptions="Start" WidthRequest="100" HeightRequest="100">
            <ContentView.ControlTemplate>
                <ControlTemplate>
                    <Border Stroke="#F3F2F1" BackgroundColor="#F3F2F1" WidthRequest="100" HeightRequest="100"
                            Padding="0">
                        <Grid>
                            <ContentPresenter HorizontalOptions="Start" VerticalOptions="Start" Margin="8,4" />
                            <Border Stroke="Blue" StrokeThickness="2" WidthRequest="24" HeightRequest="24"
                                    Padding="0" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            </Border>
                            <Border BackgroundColor="Blue" WidthRequest="10" HeightRequest="10" Padding="0"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ContentView.ControlTemplate>
            <Label Text="A" />
        </ContentView>
        <ContentView HorizontalOptions="Start" WidthRequest="100" HeightRequest="100">
            <ContentView.ControlTemplate>
                <ControlTemplate>
                    <Border Stroke="#F3F2F1" BackgroundColor="#F3F2F1" WidthRequest="100" HeightRequest="100"
                            Padding="0">
                        <Grid>
                            <ContentPresenter HorizontalOptions="Start" VerticalOptions="Start" Margin="8,4" />
                            <Border Stroke="Blue" StrokeThickness="2" WidthRequest="24" HeightRequest="24"
                                    Padding="0" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            </Border>
                            <Border BackgroundColor="Blue" WidthRequest="10" HeightRequest="10" Padding="0"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ContentView.ControlTemplate>
            <Label Text="B" />
        </ContentView>
        <ContentView HorizontalOptions="Start" WidthRequest="100" HeightRequest="100">
            <ContentView.ControlTemplate>
                <ControlTemplate>
                    <Border Stroke="#F3F2F1" BackgroundColor="#F3F2F1" WidthRequest="100" HeightRequest="100"
                            Padding="0">
                        <Grid>
                            <ContentPresenter HorizontalOptions="Start" VerticalOptions="Start" Margin="8,4" />
                            <Border Stroke="Blue" StrokeThickness="2" WidthRequest="24" HeightRequest="24"
                                    Padding="0" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            </Border>
                            <Border BackgroundColor="Blue" WidthRequest="10" HeightRequest="10" Padding="0"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ContentView.ControlTemplate>
            <Label Text="C" />
        </ContentView>
    </StackLayout>
</ContentPage>
