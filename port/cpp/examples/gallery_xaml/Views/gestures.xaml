<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gestures">
    <VerticalStackLayout Spacing="12" Padding="12">
        <!-- instructions -->
        <Label Text="Gesture target (tap / pan / pinch / swipe / pointer)" />

        <!-- the gesture target (GestureRecognizers omitted; resting appearance is the box) -->
        <BoxView Color="CornflowerBlue" HeightRequest="160" CornerRadius="8" />

        <!-- the readout (resets to none at rest) -->
        <Label Text="Last gesture: (none)" />
    </VerticalStackLayout>
</ContentPage>
