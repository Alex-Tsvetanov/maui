<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Selection Synchronization">
    <!-- Twin of SelectionSynchronization.xaml: an instructions Label + nine CollectionViews, each setting
         ItemsSource and Selected* in a documented order (the "CV" style = HeightRequest 250, Margin 5,2,5,5,
         cell = Label {Binding .} Margin 0,3,0,3). note: the per-cell "selected" visual state has no markup
         sink at rest, and the SelectedItem/SelectedItems seeds + {x:Reference} bindings + the Switch Source
         button handler are interaction wiring — degraded. Each CV shows the same four items; a per-CV readout
         Label stands in for the resting "should be selected" expectation, as the code-first page does. -->
    <ScrollView>
        <StackLayout Spacing="2">
            <Label Text="Each CollectionView below sets ItemsSource and Selected* in a particular order. Only selected items that exist in the source should stay selected." />

            <Label Text="Set ItemsSource then SelectedItems — should have items 2 and 3 selected (or nothing, if not in source)" />
            <Label Text="Selected: Item 3, Item 2" />
            <CollectionView SelectionMode="Multiple" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Set SelectedItems then ItemsSource — should have items 2 and 3 selected (or nothing, if not in source)" />
            <Label Text="Selected: Item 3, Item 2" />
            <CollectionView SelectionMode="Multiple" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Set ItemsSource then SelectedItem — should have item 2 selected (or nothing, if not in source)" />
            <Label Text="Selected: Item 2" />
            <CollectionView SelectionMode="Single" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Set SelectedItem then ItemsSource — should have item 2 selected (or nothing, if not in source)" />
            <Label Text="Selected: Item 2" />
            <CollectionView SelectionMode="Single" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Set SelectedItems (not in source) then ItemsSource — should have items 2 and 3 selected (or nothing, if not in source)" />
            <Label Text="Selected: (none)" />
            <CollectionView SelectionMode="Multiple" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Set ItemsSource then SelectedItems (not in source) — should have items 2 and 3 selected (or nothing, if not in source)" />
            <Label Text="Selected: (none)" />
            <CollectionView SelectionMode="Multiple" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Set SelectedItem (not in source) then ItemsSource — should have item 2 selected (or nothing, if not in source)" />
            <Label Text="Selected: (none)" />
            <CollectionView SelectionMode="Single" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Set ItemsSource then SelectedItem (not in source) — should have item 2 selected (or nothing, if not in source)" />
            <Label Text="Selected: (none)" />
            <CollectionView SelectionMode="Single" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Switch out ItemSource for one with only some of the SelectedItems" />
            <Button Text="Switch Source" />
            <Label Text="After hitting the button, should only have Item 3 selected" />
            <Label Text="Selected: Item 3, Item 2" />
            <CollectionView SelectionMode="Multiple" HeightRequest="250" Margin="5,2,5,5">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Item 1</x:String>
                        <x:String>Item 2</x:String>
                        <x:String>Item 3</x:String>
                        <x:String>Item 4</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Margin="0,3,0,3" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
