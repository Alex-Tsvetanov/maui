<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Polyline Gallery">
    <!-- Twin of PolylineGallery.xaml: a StackLayout (Padding 12, no ScrollView in the C# source) holding
         two Polyline variants under caption Labels — an open 10-point zig-zag (red stroke, default
         thickness) and the same with a dashed red stroke (thickness 2, dashes 1,1 / offset 6). Polyline
         does NOT auto-close. Faithful. -->
    <StackLayout Padding="12">
        <Label Text="A basic Polyline" />
        <Polyline HeightRequest="100" WidthRequest="500"
                  Stroke="Red"
                  Points="0,0 10,30 15,0 18,60 23,30 35,30 40,0 43,60 48,30 100,30" />
        <Label Text="A dash Polyline" />
        <Polyline HeightRequest="100" WidthRequest="500"
                  Stroke="Red" StrokeThickness="2"
                  StrokeDashArray="1 1" StrokeDashOffset="6"
                  Points="0,0 10,30 15,0 18,60 23,30 35,30 40,0 43,60 48,30 100,30" />
    </StackLayout>
</ContentPage>
