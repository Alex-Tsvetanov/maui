<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SwipeView">
    <!-- Twin of the maui-compare BasicSwipePage (the Windows ground truth, matched by the green cpp twin):
         a VerticalStackLayout of five SwipeViews over gray 60x300 labeled Grids (each demonstrating a
         different revealed side / SwipeMode), then a trailing readout Label. note: the loader registers
         only SwipeView.Content — the SwipeItems collections (Left/Right/Top/BottomItems) have no markup
         sink — so every SwipeView is DEGRADED to just its content Grid. This matches the RESTING
         appearance: swipe items are hidden until a gesture, so at rest each row shows only its gray "Swipe
         …" Grid, exactly as a captured screenshot shows. The content Label text renders top-left (the
         default), matching maui-compare / the cpp twin. -->
    <VerticalStackLayout Spacing="12">
        <SwipeView Margin="12">
            <SwipeView.Content>
                <Grid HeightRequest="60" WidthRequest="300" BackgroundColor="LightGray">
                    <Label Text="Swipe Up (Execute)" />
                </Grid>
            </SwipeView.Content>
        </SwipeView>
        <SwipeView HeightRequest="60" WidthRequest="300" Margin="12">
            <SwipeView.Content>
                <Grid HeightRequest="60" WidthRequest="300" BackgroundColor="LightGray">
                    <Label Text="Swipe Down (Reveal)" />
                </Grid>
            </SwipeView.Content>
        </SwipeView>
        <SwipeView HeightRequest="60" WidthRequest="300" Margin="12">
            <SwipeView.Content>
                <Grid HeightRequest="60" WidthRequest="300" BackgroundColor="LightGray">
                    <Label Text="Swipe Right (Reveal)" />
                </Grid>
            </SwipeView.Content>
        </SwipeView>
        <SwipeView HeightRequest="60" WidthRequest="300" Margin="12">
            <SwipeView.Content>
                <Grid HeightRequest="60" WidthRequest="300" BackgroundColor="LightGray">
                    <Label Text="Swipe Left (Execute)" />
                </Grid>
            </SwipeView.Content>
        </SwipeView>
        <SwipeView HeightRequest="60" WidthRequest="300" Margin="12">
            <SwipeView.Content>
                <Grid HeightRequest="60" WidthRequest="300" BackgroundColor="LightGray">
                    <Label Text="Swipe in any direction" />
                </Grid>
            </SwipeView.Content>
        </SwipeView>
        <Label Text="Swipe a row, then invoke Delete" />
    </VerticalStackLayout>
</ContentPage>
