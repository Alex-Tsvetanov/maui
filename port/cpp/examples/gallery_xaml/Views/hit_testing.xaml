<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hit testing">
    <!-- Twin of HitTestingPage.xaml: the resting UI of the hit-testing demo — a scrolled
         VerticalStackLayout (Spacing 25, Padding 30) with the "Selected: -" readout, a "Rectangle
         Selection" Label + CheckBox row, two aligned Labels (Start / End), three Buttons (Scale=1,
         Scale=2, Rotation=20), an Ellipse, a rounded Rectangle (the RoundRectangle stand-in — the
         standalone RoundRectangle shape degrades to a Rectangle with RadiusX/RadiusY) and an Image. The
         WindowOverlay hit-tester, the CheckedChanged handler and all tap interaction are pure runtime
         behavior and are omitted (resting UI only). -->
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30">
            <Label Text="Selected: -" HorizontalOptions="Center" />
            <HorizontalStackLayout>
                <Label Text="Rectangle Selection" VerticalOptions="Center" />
                <CheckBox />
            </HorizontalStackLayout>

            <Label Text="Lorem ipsum dolor sit ame" HorizontalOptions="Start" />
            <Label Text="Lorem ipsum dolor sit ame" HorizontalOptions="End" />

            <Button Text="Scale = 1" Scale="1" HorizontalOptions="Center" />
            <Button Text="Scale = 2" Scale="2" HorizontalOptions="Center" />
            <Button Text="Rotation = 20" Rotation="20" HorizontalOptions="Center" />

            <Ellipse WidthRequest="150" HeightRequest="50" StrokeThickness="10" Stroke="Green" />
            <Rectangle WidthRequest="300" HeightRequest="200" RadiusX="40" RadiusY="40" StrokeThickness="10" Stroke="Green" />

            <Image Source="dotnet_bot.png" WidthRequest="125" HeightRequest="155" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
