<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Single Bound Selection">
    <!-- Twin of the maui-compare SingleBoundSelectionPage: an instructions Label, a "Selected: …" readout
         Label, and a single-selection CollectionView bound TwoWay to SelectedItem. note: the maui-compare
         reference (the Windows ground truth) adds ONLY instructions + readout + list to its stack — the
         Reset (SelectedItem=Items[0]) / Clear (SelectedItem=null) handlers exist as methods but are wired
         to NO buttons, so no button UI renders. This twin matches that (no Buttons). The Frame cell binds
         Image + Caption; the twin flattens it to the Caption label ({Binding .}), the port's cell reduction. -->
    <VerticalStackLayout Spacing="5">
        <Label Text="The selected item in the CollectionView should match the 'Selected' Label below. If it does not, this test has failed." />
        <Label Text="Selected: (none)" />
        <CollectionView SelectionMode="Single">
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>United States</x:String>
                    <x:String>Canada</x:String>
                    <x:String>Mexico</x:String>
                    <x:String>Brazil</x:String>
                    <x:String>Argentina</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
