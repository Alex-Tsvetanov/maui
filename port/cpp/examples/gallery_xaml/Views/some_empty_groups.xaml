<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Some Empty Groups">
    <!-- Twin of SomeEmptyGroups.xaml: a description Label + a grouped CollectionView (IsGrouped=True, no
         view-level Header/Footer) with three DataTemplates — ItemTemplate ({Binding Name}), GroupHeaderTemplate
         (LightGreen bold, {Binding Name}) and GroupFooterTemplate (Orange, {Binding Count, StringFormat}). The
         page's point is that empty groups still show their header/footer. note: like the C# markup, no
         ItemsSource is set here — the List<Team> (some empty) is assigned in code-behind — so this static twin
         renders the description + the template definitions with no grouped rows. Faithful to the markup. -->
    <StackLayout Spacing="8">
        <Label Text="The CollectionView below should be grouped and some of the groups should be empty, but still display headers/footers." />
        <CollectionView IsGrouped="True">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout>
                        <Label Text="{Binding Name}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}" TextColor="LightGreen" FontAttributes="Bold" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.GroupFooterTemplate>
                <DataTemplate>
                    <Label Text="{Binding Count, StringFormat='Total members: {0}'}" TextColor="Orange" />
                </DataTemplate>
            </CollectionView.GroupFooterTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
