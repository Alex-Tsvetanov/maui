<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Grid Grouping">
    <!-- Twin of GridGrouping.xaml: a grouped CollectionView (IsGrouped=True) over a GridItemsLayout
         (Span=2, Vertical) with a view-level Header + Footer string and three DataTemplates —
         ItemTemplate ({Binding Name}), GroupHeaderTemplate (LightGreen bold {Binding Name}) and
         GroupFooterTemplate (Orange {Binding Count, StringFormat}). The GridItemsLayout element form
         degrades to the ItemsLayout string attribute (HorizontalItemSpacing is lost — acceptable). note:
         the C# markup sets NO ItemsSource — SuperTeams() is assigned in code-behind — so, like the
         original, this static twin renders the header/footer strings + the template definitions with no
         grouped rows. -->
    <CollectionView IsGrouped="True" Header="This is a header" Footer="This is a footer." ItemsLayout="VerticalGrid, 2">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Name}" Margin="5,0,0,0" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Label Text="{Binding Name}" BackgroundColor="LightGreen" FontSize="16" FontAttributes="Bold" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.GroupFooterTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Count, StringFormat='Total members: {0}'}" BackgroundColor="Orange" Margin="0,0,0,15" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.GroupFooterTemplate>
    </CollectionView>
</ContentPage>
