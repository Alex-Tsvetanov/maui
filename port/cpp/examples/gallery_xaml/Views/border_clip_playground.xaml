<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Borders">
    <!-- Twin of BorderClipPlayground.xaml: a 100x100 red-stroked Border clipping an AspectFill image
         (oasis.jpg) into a RoundRectangle, over a controls stack (shape Picker, Border-Width Slider,
         four Corner-Radius Sliders). The default resting state is reproduced: shape = RoundRectangle
         (SelectedIndex 1) with per-corner radius 60/0/0/12, width 5, and the corner-radius block visible.
         DEGRADES: (1) the Picker uses <Picker.Items> element strings instead of Picker.ItemsSource +
         x:Array (the loader has no ItemsSource text converter — same as the picker twin); (2) the readout
         labels carry static value text instead of {Binding Source={x:Reference …} StringFormat} because
         Binding.Source is deferred in the loader; (3) InfoStyle FontSize=8 is inlined on the readouts. -->
    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="5" Stroke="Red" Padding="0"
                HorizontalOptions="Center" HeightRequest="100" WidthRequest="100">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="60,0,0,12" />
            </Border.StrokeShape>
            <Image Aspect="AspectFill" Source="oasis.jpg" />
        </Border>

        <ScrollView Grid.Row="1">
            <StackLayout Spacing="6">
                <Label Text="Border Shape" />
                <Picker SelectedIndex="1">
                    <Picker.Items>
                        <x:String>Rectangle</x:String>
                        <x:String>RoundRectangle</x:String>
                        <x:String>Ellipse</x:String>
                    </Picker.Items>
                </Picker>
                <Label Text="Border" />
                <Label Text="Border Width: 5" FontSize="8" />
                <Slider Maximum="20" Minimum="0" Value="5" />
                <StackLayout Spacing="6">
                    <Label Text="Corner Radius" />
                    <Label Text="Top Left Corner Radius: 60" FontSize="8" />
                    <Slider Maximum="60" Minimum="0" Value="60" />
                    <Label Text="Top Right Corner Radius: 0" FontSize="8" />
                    <Slider Maximum="60" Minimum="0" />
                    <Label Text="Bottom Left Corner Radius: 0" FontSize="8" />
                    <Slider Maximum="60" Minimum="0" />
                    <Label Text="Bottom Right Corner Radius: 12" FontSize="8" />
                    <Slider Maximum="60" Minimum="0" Value="12" />
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
