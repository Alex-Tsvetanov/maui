<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dispatcher">
    <ScrollView>
        <StackLayout Spacing="10" Padding="20">
            <!-- Row 1: Fail Access -->
            <Label Text="Watch the machines complain about accessing the UI thread from the background:" />
            <Button Text="Fail Access" />
            <Label Text="..." />

            <!-- Row 2: Access (happy path) — seeded result shown at rest -->
            <Label Text="Now observe the happy machines when using a dispatcher:" />
            <Button Text="Access" />
            <Label Text="This was a success!" />

            <!-- Row 3: 3 Seconds Later — seeded result shown at rest -->
            <Label Text="Maybe you want something to happen in a few seconds:" />
            <Button Text="3 Seconds Later" />
            <Label Text="I happened 3 seconds later!" />

            <!-- Row 4: 3 Second Timer — seeded result shown at rest -->
            <Label Text="Or, you might want something to repeat like a timer:" />
            <Button Text="3 Second Timer (Start/Stop)" />
            <Label Text="I am on a 3 second timer! 3 ticks" />

            <!-- Row 5: the OBSOLETE Device.StartTimer(3s) row -->
            <Label Text="OBSOLETE ZONE ALERT!" />
            <Label Text="Some old code still works:" />
            <Button Text="Device.StartTimer(3s)  (Start/Stop)" />
            <Label Text="..." />
        </StackLayout>
    </ScrollView>
</ContentPage>
