<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Navigation gallery">
    <!-- Twin of NavigationGallery.xaml: a stack-state readout over six buttons driving the code-first
         navigation stack (Push / Pop / Insert / Remove / Pop To Root / Toggle Secondary Toolbar Item).
         Interactivity is omitted; the resting readout reflects the single-page root stack. -->
    <VerticalStackLayout Spacing="8">
        <Label Text="Stack depth: 1  |  top: PAGE NUMBER 1  |  secondary toolbar items: 0" />
        <Button Text="Push Page" />
        <Button Text="Pop Page" />
        <Button Text="Insert Page Before Current" />
        <Button Text="Remove Page Before Current" />
        <Button Text="Pop To Root" />
        <Button Text="Toggle Secondary Toolbar Item" />
    </VerticalStackLayout>
</ContentPage>
