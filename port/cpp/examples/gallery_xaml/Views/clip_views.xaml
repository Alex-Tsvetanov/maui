<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClipViews Gallery">
    <!-- Twin of ClipViewsGallery.xaml: a ScrollView over a StackLayout (Padding 12) proving the Clip surface
         works on EVERY kind of view — seven Red-backgrounded controls each sharing ONE ellipse clip. DEGRADES:
         the loader registers no Clip property and no EllipseGeometry element, so the shared clip is omitted —
         each control renders as its plain Red-backgrounded resting form (still the full set of view types).
         The single shared StaticResource ellipse collapses to nothing visible in markup at rest anyway. -->
    <ScrollView>
        <StackLayout Spacing="6" Padding="12">
            <Button Text="Button" BackgroundColor="Red" />
            <DatePicker BackgroundColor="Red" />
            <Entry Placeholder="Entry" BackgroundColor="Red" />
            <Editor Placeholder="Editor" BackgroundColor="Red" />
            <Grid HeightRequest="50" BackgroundColor="Red">
                <Label Text="Grid" />
            </Grid>
            <SearchBar BackgroundColor="Red" />
            <TimePicker BackgroundColor="Red" />
        </StackLayout>
    </ScrollView>
</ContentPage>
