<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Shadow Playground">
    <!-- Twin of ShadowPlaygroundPage.xaml: two shadowed targets (a Label + a #00B4DB "View" rectangle) above
         a scrolled column of shadow inputs — a Background hex Entry, a Shadow Color hex Entry, Offset X/Y,
         Radius and Opacity Sliders (each with a readout Label), and a Remove Shadow Button. note: the Shadow
         itself is applied through the slider/entry change handlers (the M5 binding seam) with no resting
         markup sink, so the shadow-apply wiring is degraded; the twin reproduces the resting control column
         and the default readouts. The "View" rectangle is a BoxView, the headless-safe shadow target. -->
    <VerticalStackLayout Spacing="12">
        <Label Text="Label with a Shadow" />
        <BoxView Color="#00B4DB" WidthRequest="75" HeightRequest="50" />
        <ScrollView>
            <VerticalStackLayout Spacing="8">
                <Label Text="Background" />
                <Entry Text="#00B4DB" Placeholder="Background Color Hex" />
                <Label Text="Shadow" />
                <Label Text="Shadow Color" />
                <Entry Text="#FF0000" Placeholder="Shadow Color Hex" />
                <Label Text="Offset X: 10" />
                <Slider Minimum="-20" Maximum="20" Value="10" />
                <Label Text="Offset Y: 10" />
                <Slider Minimum="-20" Maximum="20" Value="10" />
                <Label Text="Radius: 10" />
                <Slider Minimum="0" Maximum="20" Value="10" />
                <Label Text="Opacity: 1.00" />
                <Slider Minimum="0" Maximum="1" Value="1" />
                <Button Text="Remove Shadow" />
            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>
