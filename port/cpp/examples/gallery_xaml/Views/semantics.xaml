<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Semantics">
    <!-- Twin of SemanticsPage.xaml: an accessibility showcase — labels/buttons/entry/editor/search bar each
         carrying SemanticProperties.Description/.Hint, a HeadingLevel block, and two layout-level
         descriptions. note: SemanticProperties.Description/.Hint/.HeadingLevel are accessibility attached
         properties with no visible rendering at rest, and SetSemanticFocus() is a native focus call — both
         degraded; the twin reproduces the resting text of every control. The readout Label echoes the
         focused control's semantics in the code-first page. -->
    <ScrollView>
        <VerticalStackLayout Spacing="10">
            <Label Text="SemanticProperties showcase: Description (D), Hint (H), HeadingLevel." />
            <Label Text="Semantics readout: (interact to inspect)" />

            <Label Text="Label text TH" />
            <Label Text="Label text DH" />
            <Button Text="Button text TH" />
            <Button Text="Button text DH" />

            <Entry Text="Entry text, DTH" />
            <Editor Text="Editor text, DTH" />
            <SearchBar Text="Search bar text, DH" Placeholder="Placeholder text" />

            <Label Text="HeadingLevel labels (assistive tech navigates by heading):" />
            <Label Text="Heading 1" />
            <Label Text="Heading 2" />
            <Label Text="Heading 3" />
            <Label Text="Heading 4 with semantic description and hint" />

            <Label Text="Layouts can carry a Description too:" />
            <VerticalStackLayout Spacing="4">
                <Label Text="Label in StackLayout with semantic description" />
                <Label Text="Label in StackLayout with semantic description" />
            </VerticalStackLayout>

            <Button Text="Click to set semantic focus to label below" />
            <Label Text="Label receiving semantic focus" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
