<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BoxView">
    <ScrollView>
        <VerticalStackLayout Spacing="6" Padding="12">
            <Label Text="Default" />
            <BoxView BackgroundColor="CornflowerBlue" WidthRequest="160" HeightRequest="160" />

            <Label Text="Using Color" />
            <BoxView Color="Purple" WidthRequest="160" HeightRequest="160" />

            <Label Text="Background" />
            <BoxView WidthRequest="160" HeightRequest="160">
                <BoxView.Background>
                    <LinearGradientBrush EndPoint="1,0">
                        <GradientStop Color="Yellow" Offset="0.1" />
                        <GradientStop Color="Green" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Label Text="Using CornerRadius" />
            <BoxView Color="LightGreen" CornerRadius="10" WidthRequest="160" HeightRequest="160" />

            <Label Text="Using Complex CornerRadius" />
            <BoxView Color="Orange" CornerRadius="10,0,5,20" WidthRequest="160" HeightRequest="160" />

            <Label Text="Using Opacity" />
            <BoxView Color="Orange" Opacity="0.5" WidthRequest="160" HeightRequest="160" />

            <Label Text="Clip" />
            <BoxView Color="Pink" WidthRequest="160" HeightRequest="160" />

            <Label Text="Shadow" />
            <BoxView Color="Pink" WidthRequest="160" HeightRequest="160" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
