<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Editor">
    <VerticalStackLayout Spacing="12">
        <Label Text="LENGTH: 0" />
        <Editor Placeholder="Type here..." />
        <Editor Text="Text" TextColor="Purple" />
        <Editor Placeholder="Placeholder" PlaceholderColor="Purple" />
        <Editor Text="FontSize (Large)" Placeholder="FontSize (Large)" FontSize="24" CharacterSpacing="4" />
        <Editor Text="I am read only" IsReadOnly="True" />
        <Editor Text="123" Keyboard="Numeric" />
        <Editor Text="This should be on the bottom" VerticalTextAlignment="End" />
        <Label Text="AUTOSIZE LENGTH: 0" />
        <Editor Placeholder="Grows as you type..." AutoSize="TextChanges" />
    </VerticalStackLayout>
</ContentPage>
