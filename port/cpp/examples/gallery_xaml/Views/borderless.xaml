<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             BackgroundColor="Yellow"
             Title="Border without Stroke">
    <!-- Twin of the maui-compare BorderlessPage (the Windows ground truth): a yellow page whose Content is
         a VerticalStackLayout (Spacing 8) of a "Style: borderless (StrokeThickness 0)" readout Label, a
         Switch (starts OFF = borderless), then a two-row Grid (*,* / RowSpacing 0) of a Pink Border over a
         Red Border, each carrying the keyed BorderlessStyle (StrokeThickness 0). The Grid holds empty
         Star-row Borders, so inside the stack it collapses to no height at rest — the resting render is the
         yellow page + readout + switch (matching the cpp twin), NOT a pink/red split. (The prior twin
         mirrored the UPSTREAM Borderless.xaml — Grid as the direct page content — which fills the page
         pink-over-red and drops the switch/readout; maui-compare is the ground truth, not upstream.)
         Style / Setter / {StaticResource} are all supported by the loader. -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="BorderlessStyle" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <VerticalStackLayout Spacing="8">
        <Label Text="Style: borderless (StrokeThickness 0)" />
        <Switch />
        <Grid RowDefinitions="*,*" RowSpacing="0">
            <Border Background="Pink" Style="{StaticResource BorderlessStyle}" />
            <Border Grid.Row="1" Background="Red" Style="{StaticResource BorderlessStyle}" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>
