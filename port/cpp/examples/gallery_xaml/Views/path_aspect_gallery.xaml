<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Path Aspect Gallery">
    <!-- Twin of PathAspectGallery.xaml: four identical 100x100 Paths (LightGray background, Yellow stroke,
         Red fill, StrokeThickness 1, HorizontalOptions=Start) over one bird-silhouette geometry, captioned
         and differing only by Aspect (None / Fill / Uniform / UniformToFill). The implicit Path style is
         inlined per the supported dialect. Faithful. -->
    <VerticalStackLayout Padding="12">
        <!-- Path.Data geometry is unsupported (and BackgroundColor/HorizontalOptions are not on the shape
             surface). Each of the four identical bird-silhouette Paths — which in the original differ only by
             Aspect (None/Fill/Uniform/UniformToFill) — degrades to a Polygon approximating the silhouette,
             wrapped in a LightGray 100x100 Grid that preserves the panel background and Start alignment. The
             Aspect attribute IS supported on Polygon (it maps to the native Stretch), so it is carried on each
             shape to reproduce the four distinct aspect fittings, matching the cpp twin. -->
        <Label Text="None" />
        <Grid BackgroundColor="LightGray" WidthRequest="100" HeightRequest="100" HorizontalOptions="Start">
            <Polygon Points="4,50 26,12 50,4 74,12 96,50 74,88 50,96 26,88"
                     Stroke="Yellow" Fill="Red" StrokeThickness="1" Aspect="None" />
        </Grid>

        <Label Text="Fill" />
        <Grid BackgroundColor="LightGray" WidthRequest="100" HeightRequest="100" HorizontalOptions="Start">
            <Polygon Points="4,50 26,12 50,4 74,12 96,50 74,88 50,96 26,88"
                     Stroke="Yellow" Fill="Red" StrokeThickness="1" Aspect="Fill" />
        </Grid>

        <Label Text="Uniform" />
        <Grid BackgroundColor="LightGray" WidthRequest="100" HeightRequest="100" HorizontalOptions="Start">
            <Polygon Points="4,50 26,12 50,4 74,12 96,50 74,88 50,96 26,88"
                     Stroke="Yellow" Fill="Red" StrokeThickness="1" Aspect="Uniform" />
        </Grid>

        <Label Text="UniformToFill" />
        <Grid BackgroundColor="LightGray" WidthRequest="100" HeightRequest="100" HorizontalOptions="Start">
            <Polygon Points="4,50 26,12 50,4 74,12 96,50 74,88 50,96 26,88"
                     Stroke="Yellow" Fill="Red" StrokeThickness="1" Aspect="UniformToFill" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>
