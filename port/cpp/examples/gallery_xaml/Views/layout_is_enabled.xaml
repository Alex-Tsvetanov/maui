<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Layout IsEnabled">
    <!-- Twin of LayoutIsEnabledPage.xaml: a 2x2 Grid (columns *,*; rows Auto,Auto) inside a ScrollView.
         Left column: MainLayout with six state-demo sub-stacks (row 0) over two control buttons (row 1).
         Right column: a layout whose IsEnabled starts disabled (row 0) over three checkboxes (row 1). The
         command CanExecute / two-way bindings are interactivity, omitted — the resting layout + disabled
         states are reproduced. -->
    <ScrollView>
        <Grid RowSpacing="6" ColumnSpacing="6" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <!-- Left column, row 0: MainLayout with the six state-demo sub-stacks -->
            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Padding="6" Spacing="6">
                <Label Text="All children are enabled" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightBlue">
                    <Button Text="Enabled" />
                    <Button Text="Enabled" />
                </VerticalStackLayout>

                <Label Text="All children are disabled" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightBlue">
                    <Button Text="Disabled" IsEnabled="False" />
                    <Button Text="Disabled" IsEnabled="False" />
                </VerticalStackLayout>

                <Label Text="All children are disabled (because layout is disabled)" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightPink" IsEnabled="False">
                    <Button Text="Enabled" />
                    <Button Text="Enabled" />
                </VerticalStackLayout>

                <Label Text="First item is enabled and the second one is disabled" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightSeaGreen">
                    <Button Text="Enabled" />
                    <Button Text="Disabled" IsEnabled="False" />
                </VerticalStackLayout>

                <Label Text="Children have commands attached" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightSeaGreen">
                    <Button Text="Enabled" />
                    <Button Text="Disabled" IsEnabled="False" />
                </VerticalStackLayout>

                <Label Text="Nested layouts" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightSkyBlue">
                    <VerticalStackLayout Padding="6" BackgroundColor="LightGray">
                        <Button Text="Enabled" />
                        <Button Text="Disabled" IsEnabled="False" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Left column, row 1: the two control buttons -->
            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Padding="6" Spacing="6">
                <Button Text="Disable Layout" />
                <Button Text="Enable Button" />
            </VerticalStackLayout>

            <!-- Right column, row 0: a layout whose IsEnabled starts disabled -->
            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Padding="6" Spacing="6" IsEnabled="False">
                <Label Text="All children are enabled" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightBlue">
                    <Button Text="Enabled" />
                    <Button Text="Enabled" />
                </VerticalStackLayout>

                <Label Text="All children are disabled" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightBlue">
                    <Button Text="Disabled" IsEnabled="False" />
                    <Button Text="Disabled" IsEnabled="False" />
                </VerticalStackLayout>

                <Label Text="All children are disabled (because layout is disabled)" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightPink" IsEnabled="False">
                    <Button Text="Enabled" />
                    <Button Text="Enabled" />
                </VerticalStackLayout>

                <Label Text="First item is enabled and the second one is disabled" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightSeaGreen">
                    <Button Text="Enabled" />
                    <Button Text="Disabled" IsEnabled="False" />
                </VerticalStackLayout>

                <Label Text="Children have commands attached" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightSeaGreen">
                    <Button Text="Enabled" />
                    <Button Text="Disabled" IsEnabled="False" />
                </VerticalStackLayout>

                <Label Text="Nested layouts" />
                <VerticalStackLayout Padding="6" BackgroundColor="LightSkyBlue">
                    <VerticalStackLayout Padding="6" BackgroundColor="LightGray">
                        <Button Text="Enabled" />
                        <Button Text="Disabled" IsEnabled="False" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Right column, row 1: the three checkboxes -->
            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Padding="6" Spacing="6">
                <Label Text="Enable/Disable Layout" />
                <CheckBox />
                <Label Text="Enable/Disable Button" />
                <CheckBox />
                <Label Text="Enable/Disable Command" />
                <CheckBox />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
