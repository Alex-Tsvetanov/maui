<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Header/Footer (view)">
    <!-- Twin of HeaderFooterView.xaml: a CollectionView whose Header + Footer are each a VIEW. The Header
         is a Grid (an AspectFill oasis.jpg Image overlaid by a centered bold AntiqueWhite Label); the
         Footer is a 2x2 Grid (a cover1.jpg Image + a rotated bold AntiqueWhite Label spanning the top row,
         and two Buttons — "Add 2 Items" / "Clear All Items" — on the bottom row). The bound HeaderText /
         FooterText degrade to their constant strings; the buttons' Command bindings are omitted (resting
         UI). The source starts empty (HeaderFooterViewModel(0)), so no rows are inlined — matching the
         initial state the buttons fill on demand. -->
    <!-- CollectionView.Header / .Footer (view form) are unsupported, so the header Grid and footer Grid are
         moved to plain siblings ABOVE / BELOW the CollectionView. They are hosted in a 3-ROW Grid
         (header Auto / CollectionView "*" / footer Auto) rather than a VerticalStackLayout, so the empty
         middle CollectionView EXPANDS to fill and the footer pins to the BOTTOM — matching MAUI's real CV
         (which fills its container and bottom-anchors the footer over an empty source) and the cpp twin. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Image Source="oasis.jpg" Aspect="AspectFill" HeightRequest="100" />
            <Label Text="This Is A Header" TextColor="AntiqueWhite" HorizontalTextAlignment="Center"
                   FontAttributes="Bold" FontSize="36" />
        </Grid>
        <CollectionView Grid.Row="1" />
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image Source="cover1.jpg" Aspect="AspectFill" HeightRequest="80" Grid.Row="0" Grid.ColumnSpan="2" />
            <Label Text="This Is A Footer" TextColor="AntiqueWhite" HorizontalTextAlignment="Center" Rotation="10"
                   FontAttributes="Bold" FontSize="20" Grid.Row="0" Grid.ColumnSpan="2" />
            <Button Text="Add 2 Items" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" />
            <Button Text="Clear All Items" Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
