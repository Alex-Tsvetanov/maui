<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SwipeItem Position Gallery">
    <!-- Twin of SwipeItemPositionGallery.xaml: a 2-row Grid (Auto picker / * swipe view). The picker
         chooses the SwipeMode (Reveal/Execute) applied to all four SwipeItems collections. note: the
         loader registers only SwipeView.Content — the Left/Top/Right/BottomItems collections have no
         markup sink — so the SwipeView is DEGRADED to just its translucent-white content Grid, which is
         exactly the RESTING appearance (swipe items are hidden until a gesture). -->
    <Grid RowDefinitions="Auto,*">
        <Picker Title="Select a Mode" Grid.Row="0">
            <Picker.Items>
                <x:String>Reveal</x:String>
                <x:String>Execute</x:String>
            </Picker.Items>
        </Picker>
        <SwipeView Grid.Row="1">
            <SwipeView.Content>
                <Grid BackgroundColor="White" Opacity="0.75">
                    <Label Text="Swipe in any direction" />
                </Grid>
            </SwipeView.Content>
        </SwipeView>
    </Grid>
</ContentPage>
