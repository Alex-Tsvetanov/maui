<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Border Alignment">
    <VerticalStackLayout Spacing="12" Padding="16">
        <Label Text="Start" FontSize="20" FontAttributes="Bold" />
        <Border Stroke="Red" StrokeThickness="5" WidthRequest="160" HeightRequest="40" HorizontalOptions="Start">
            <Label Text="Start" TextColor="White" BackgroundColor="Blue" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>
        <Label Text="Center" FontSize="20" FontAttributes="Bold" />
        <Border Stroke="Red" StrokeThickness="5" WidthRequest="160" HeightRequest="40" HorizontalOptions="Center">
            <Label Text="Center" TextColor="White" BackgroundColor="Blue" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>
        <Label Text="End" FontSize="20" FontAttributes="Bold" />
        <Border Stroke="Red" StrokeThickness="5" WidthRequest="160" HeightRequest="40" HorizontalOptions="End">
            <Label Text="End" TextColor="White" BackgroundColor="Blue" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>
        <Label Text="Fill" FontSize="20" FontAttributes="Bold" />
        <Border Stroke="Red" StrokeThickness="5" WidthRequest="160" HeightRequest="40" HorizontalOptions="Fill">
            <Label Text="Fill" TextColor="White" BackgroundColor="Blue" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>
    </VerticalStackLayout>
</ContentPage>
