<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Filter CollectionView Items">
    <Grid Padding="12" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: the "Use EmptyView" Label + Switch (on) -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Use EmptyView" VerticalTextAlignment="Center" />
            <Switch IsToggled="True" />
        </HorizontalStackLayout>

        <!-- Row 1: the "Filter" SearchBar -->
        <SearchBar Grid.Row="1" Placeholder="Filter" />

        <!-- Row 2: the CollectionView (2-span vertical grid of caption labels). CollectionView.EmptyView
             (view form) is unsupported, so the coral "Nothing to see here" Label is moved to a plain sibling
             in the same cell; at rest the source is full so the item cells show over it. -->
        <Label Grid.Row="2" Text="Nothing to see here" TextColor="Coral"
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        <CollectionView Grid.Row="2" ItemsLayout="VerticalGrid, 2">
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>cover1.jpg, 0</x:String>
                    <x:String>oasis.jpg, 1</x:String>
                    <x:String>photo.jpg, 2</x:String>
                    <x:String>Vegetables.jpg, 3</x:String>
                    <x:String>Fruits.jpg, 4</x:String>
                    <x:String>FlowerBuds.jpg, 5</x:String>
                    <x:String>Legumes.jpg, 6</x:String>
                    <x:String>cover1.jpg, 7</x:String>
                    <x:String>oasis.jpg, 8</x:String>
                    <x:String>photo.jpg, 9</x:String>
                    <x:String>Vegetables.jpg, 10</x:String>
                    <x:String>Fruits.jpg, 11</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Margin="6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
