<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Path Gallery">
    <!-- Twin of PathGallery.xaml: a ScrollView over a StackLayout (Padding 12) walking eight captioned
         Path variants (plus two markup-string caption Labels). Markup-driven Paths use Data strings;
         element-authored geometries (PathGeometry/GeometryGroup with figures/segments/ellipse/rectangle)
         use the object-element geometry syntax. Every Path carries Aspect=Uniform + HorizontalOptions=
         Start (the implicit Path style, inlined). Faithful. -->
    <ScrollView>
        <VerticalStackLayout Padding="12">
            <!-- Path.Data geometry (string and element form) is unsupported; each Path degrades to the
                 supported shape that best matches its resting silhouette. Aspect / HorizontalOptions are not
                 on the shape surface and are dropped (the shapes carry their own fixed size). -->

            <!-- #1 LineSegment "M 10,50 L 200,70" -> a Line with the same endpoints. -->
            <Label Text="Create a LineSegment in a PathGeometry" />
            <Line X1="10" Y1="50" X2="200" Y2="70" Stroke="Black" StrokeThickness="1" />

            <!-- #2 Closed triangle (10,100)(100,100)(100,50) -> a Polygon. -->
            <Label Text="Create a Shape by Using a PathGeometry" />
            <Polygon Points="10,100 100,100 100,50" Stroke="Black" StrokeThickness="1" />

            <!-- #3 Cubic Bezier "M 10,100 C 100,0 200,200 300,100" -> a Polyline sampling the S-curve. -->
            <Label Text="Cubic Bezier Path" />
            <Polyline Points="10,100 85,45 155,100 225,155 300,100" Stroke="Black" StrokeThickness="1" />

            <!-- #4 Composite (four concentric ellipses, EvenOdd) -> the outer ring as one filled Ellipse. -->
            <Label Text="Composite shape" />
            <Ellipse Fill="#CCCCFF" Stroke="Black" StrokeThickness="1"
                     WidthRequest="120" HeightRequest="120" />

            <!-- #5 Overlapping Rectangles (two rectangle geometries) -> a single red Rectangle. -->
            <Label Text="Overlapping Rectangles" />
            <Rectangle Fill="Red" Stroke="Red" StrokeThickness="3"
                       WidthRequest="100" HeightRequest="100" />

            <!-- #6 EllipseGeometry (four-circle 2x2 cluster) -> a single orange Ellipse. -->
            <Label Text="EllipseGeometry" />
            <Ellipse Fill="Orange" Stroke="Green" StrokeThickness="2"
                     WidthRequest="100" HeightRequest="100" />

            <!-- #7 Open star outline (five line segments) -> a Polyline through the same points. -->
            <Label Text="Multiple Line Segments" />
            <Polyline Points="144,72 200,246 53,138 235,138 88,246"
                      Stroke="Maroon" StrokeThickness="3" />

            <!-- #8 Complex Paths: the two glyph markup strings, each shown as a caption then approximated. -->
            <Label Text="Complex Paths" />
            <Label Text="M13.908992,16.207977L32.000049,16.207977 32.000049,31.999985 13.908992,30.109983z M0,16.207977L11.904009,16.207977 11.904009,29.900984 0,28.657984z M11.904036,2.0979624L11.904036,14.202982 2.7656555E-05,14.202982 2.7656555E-05,3.3409645z M32.000058,0L32.000058,14.203001 13.909059,14.203001 13.909059,1.8890382z" FontSize="9" />
            <!-- The four-quadrant windowpane glyph -> a bordered Rectangle placeholder. -->
            <Rectangle Stroke="Black" StrokeThickness="1" WidthRequest="100" HeightRequest="100" />

            <Label Text="M8.0886959,0L8.687694,0C12.279728,0.2989963 14.275696,2.2949993 15.971676,4.9890003 ... 8.0886959,0z" FontSize="9" />
            <!-- The rounded blob glyph -> a red-filled, yellow-stroked Ellipse placeholder. -->
            <Ellipse Fill="Red" Stroke="Yellow" StrokeThickness="1" WidthRequest="100" HeightRequest="100" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
