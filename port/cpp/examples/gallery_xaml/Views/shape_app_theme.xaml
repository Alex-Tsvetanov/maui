<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Shapes AppTheme Gallery">
    <!-- Twin of ShapeAppThemeGallery.xaml: a StackLayout (Padding 12) with a caption Label and a 200x80
         Rectangle, all themed via {AppThemeBinding}. The Rectangle Fill/Stroke and the Label TextColor turn
         Green in light and Red in dark; the layout background is White (light) / Black (dark). note: the C#
         page rides three DynamicResource {AppThemeBinding} styles from a ResourceDictionary; the twin inlines
         the resolved AppThemeBinding on each element (the port has no <Color x:Key> resource-element or
         implicit-style hydration), which a static capture resolves to the Light branch. -->
    <StackLayout Padding="12"
                 BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">
        <Label Text="Shape using AppTheme"
               TextColor="{AppThemeBinding Light=Green, Dark=Red}" />
        <Rectangle WidthRequest="200"
                   HeightRequest="80"
                   Fill="{AppThemeBinding Light=Green, Dark=Red}"
                   Stroke="{AppThemeBinding Light=Green, Dark=Red}" />
    </StackLayout>
</ContentPage>
