<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Picker UpdateMode">
    <!-- Twin of iOSPickerPage.xaml: a "Select a monkey" Picker (iOS UpdateMode knob) over a toggle
         button. The ios:Picker.UpdateMode attached property is a platform-config knob with no resting
         visual and no supported markup sink, so it is omitted; the Picker + button render at rest. -->
    <VerticalStackLayout Spacing="12">
        <Picker Title="Select a monkey">
            <Picker.Items>
                <x:String>Baboon</x:String>
                <x:String>Capuchin Monkey</x:String>
                <x:String>Blue Monkey</x:String>
                <x:String>Squirrel Monkey</x:String>
                <x:String>Golden Lion Tamarin</x:String>
                <x:String>Howler Monkey</x:String>
                <x:String>Japanese Macaque</x:String>
            </Picker.Items>
        </Picker>
        <Button Text="Toggle Picker UpdateMode" />
    </VerticalStackLayout>
</ContentPage>
