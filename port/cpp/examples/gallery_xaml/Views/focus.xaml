<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Focus">
    <VerticalStackLayout Spacing="10" Padding="12">
        <!-- the focus target entry (focus events wire the info log; omitted) -->
        <Entry Placeholder="Focus target" />

        <!-- the two control buttons, side by side (Clicked handlers omitted) -->
        <HorizontalStackLayout Spacing="8">
            <Button Text="Focus Entry" />
            <Button Text="Unfocus Entry" />
        </HorizontalStackLayout>

        <!-- the IsFocused readout -->
        <Label Text="IsFocused: false" />

        <!-- the scrolling info log (empty at rest) -->
        <ScrollView>
            <Label Text="" />
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>
