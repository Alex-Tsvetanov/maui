<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EmptyView (string)">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: the filter SearchBar -->
        <SearchBar Placeholder="Filter" Grid.Row="0" />

        <!-- Row 1: the CollectionView. The source starts POPULATED, so the ground truth (maui-compare +
             the green cpp twin) shows only the item cells at rest with no EmptyView text. EmptyView (string
             form) is unsupported by the loader, but a static sibling "No items match your filter." Label
             would render OVER the populated list at rest (wrong), so it is omitted — the EmptyView only
             matters once the SearchBar filters to empty, which no capture exercises. -->
        <CollectionView Grid.Row="1">
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>cover1.jpg, 0</x:String>
                    <x:String>oasis.jpg, 1</x:String>
                    <x:String>photo.jpg, 2</x:String>
                    <x:String>Vegetables.jpg, 3</x:String>
                    <x:String>Fruits.jpg, 4</x:String>
                    <x:String>FlowerBuds.jpg, 5</x:String>
                    <x:String>Legumes.jpg, 6</x:String>
                    <x:String>cover1.jpg, 7</x:String>
                    <x:String>oasis.jpg, 8</x:String>
                    <x:String>photo.jpg, 9</x:String>
                    <x:String>Vegetables.jpg, 10</x:String>
                    <x:String>Fruits.jpg, 11</x:String>
                    <x:String>FlowerBuds.jpg, 12</x:String>
                    <x:String>Legumes.jpg, 13</x:String>
                    <x:String>cover1.jpg, 14</x:String>
                    <x:String>oasis.jpg, 15</x:String>
                    <x:String>photo.jpg, 16</x:String>
                    <x:String>Vegetables.jpg, 17</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Margin="6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
