<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Line Gallery">
    <!-- Twin of LineGallery.xaml: three Lines, each under a caption Label. No ScrollView — the
         StackLayout (Padding 12) is the page content directly. -->
    <StackLayout Padding="12">
        <Label Text="A basic Line" />
        <Line WidthRequest="120" HeightRequest="120" Stroke="Purple" X1="40" Y1="0" X2="0" Y2="120" />

        <Label Text="A dash Line" />
        <Line WidthRequest="120" HeightRequest="120" Stroke="Orange" StrokeDashArray="1,1" StrokeDashOffset="6" X1="40" Y1="0" X2="0" Y2="120" />

        <Label Text="A Line using StrokeThickness" />
        <Line WidthRequest="50" HeightRequest="50" Stroke="Black" StrokeThickness="4" X1="10" Y1="10" X2="50" Y2="50" />
    </StackLayout>
</ContentPage>
