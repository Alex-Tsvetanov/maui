<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ContentView">
    <ScrollView>
        <VerticalStackLayout Spacing="12">
            <Label Text="ContentView" />
            <ContentView Padding="12">
                <Label Text="Content" />
            </ContentView>
            <Label Text="Content" />
            <Button Text="Swap content" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
