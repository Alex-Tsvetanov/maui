<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Transform Playground">
    <!-- Twin of TransformPlaygroundGallery.xaml: a 200x200 light-grey panel hosting a 50x50 Path
         rectangle (red fill, blue stroke 4), over a ScrollView of Slider rows that drive the Path's
         RenderTransform (rotate/scale/skew/translate). Static resting layout only — the value_changed
         wiring is interactive and omitted. Readout labels carry the at-rest slider values. -->
    <VerticalStackLayout Spacing="0">
        <VerticalStackLayout BackgroundColor="#e5e5e5" WidthRequest="200" HeightRequest="200">
            <!-- Path.Data geometry is unsupported; the closed 50x50 square "M 0,0 L 50,0 50,50 0,50 Z" is
                 exactly a Rectangle, so the Path degrades to a 50x50 Rectangle with the same fill/stroke. -->
            <Rectangle Fill="Red" Stroke="Blue" StrokeThickness="4" WidthRequest="50" HeightRequest="50" />
        </VerticalStackLayout>
        <ScrollView Padding="12">
            <VerticalStackLayout Spacing="0">
                <Label Text="RotateTransform" />
                <Label Text="Rotation: 0" />
                <Slider Minimum="0" Maximum="200" Value="0" />
                <Label Text="CenterX: 0" />
                <Slider Minimum="0" Maximum="100" Value="0" />
                <Label Text="CenterY: 0" />
                <Slider Minimum="0" Maximum="100" Value="0" />

                <Label Text="ScaleTransform" />
                <Label Text="ScaleX: 1.00" />
                <Slider Minimum="0.5" Maximum="2" Value="1" />
                <Label Text="ScaleY: 1.00" />
                <Slider Minimum="0.5" Maximum="2" Value="1" />

                <Label Text="SkewTransform" />
                <Label Text="SkewX: 0" />
                <Slider Minimum="0" Maximum="100" Value="0" />
                <Label Text="SkewY: 0" />
                <Slider Minimum="0" Maximum="100" Value="0" />

                <Label Text="TranslateTransform" />
                <Label Text="X: 0" />
                <Slider Minimum="0" Maximum="200" Value="0" />
                <Label Text="Y: 0" />
                <Slider Minimum="0" Maximum="200" Value="0" />
            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>
