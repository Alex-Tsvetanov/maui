<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Minimal Info.plist for the iOS sample .app bundle (configured by CMake via MACOSX_BUNDLE_INFO_PLIST).
     Deliberately has NO UIApplicationSceneManifest: the app runs the classic (non-scene)
     UIApplicationDelegate lifecycle — the very path the port's window_handler mirrors (C#'s
     `!HasSceneManifest()` branch). UILaunchScreen (empty) opts into the modern full-size launch without
     a storyboard. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>@MACOSX_BUNDLE_EXECUTABLE_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@MACOSX_BUNDLE_GUI_IDENTIFIER@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@MACOSX_BUNDLE_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@MACOSX_BUNDLE_SHORT_VERSION_STRING@</string>
	<key>CFBundleVersion</key>
	<string>@MACOSX_BUNDLE_BUNDLE_VERSION@</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
