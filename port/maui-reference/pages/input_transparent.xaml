<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.InputTransparentPage" Title="Input transparent">
    <VerticalStackLayout Spacing="8">
        <Label Text="Single button, InputTransparent=false: should be clickable." />
        <Button Text="Clickable" InputTransparent="False" />
        <Button Text="Tap single clickable" />

        <Label Text="Single button, InputTransparent=true: should NOT be clickable (tap passes through)." />
        <Button Text="Not Clickable" InputTransparent="True" />
        <Button Text="Tap single transparent" />

        <Label Text="Overlay: top InputTransparent=true over a clickable bottom; tap routes to the bottom." />
        <Grid>
            <Button Text="Bottom (clickable)" InputTransparent="False" />
            <Button Text="Top (transparent)" InputTransparent="True" />
        </Grid>
        <Button Text="Tap overlay" />

        <Label Text="Toggle: flip the test button's InputTransparent; the tap re-routes between the two layers." />
        <Grid>
            <Button Text="Bottom Layer" InputTransparent="False" />
            <Button Text="Test Button" InputTransparent="False" />
        </Grid>
        <Switch />
        <Button Text="Tap toggle set" />

        <Label Text="Ready — tap a layer set below" />
    </VerticalStackLayout>
</ContentPage>
