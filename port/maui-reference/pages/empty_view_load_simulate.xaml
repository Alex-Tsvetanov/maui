<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.EmptyViewLoadSimulatePage" Title="EmptyView (load simulation)">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 1: the CollectionView starts EMPTY (no ItemsSource). EmptyView is unsupported (neither
             string nor element form), so the empty-state message is rendered as a plain sibling Label in
             the same cell — which is what shows at rest, since the source is empty. GridItemsLayout Span="3"
             Vertical (LinearItemsLayout element form unsupported -> string attribute form). -->
        <Label Grid.Row="1" Text="Items loading simulation..." />
        <CollectionView Grid.Row="1" ItemsLayout="VerticalGrid, 3">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Margin="6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
