<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.EmptyViewLoadSimulatePage" Title="EmptyView (load simulation)">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 1: the CollectionView starts EMPTY (no ItemsSource), so the string-form EmptyView is what
             renders at rest (the EmptyViewLoadSimulateGallery oracle). GridItemsLayout Span="3" Vertical
             (GridItemsLayout element form unsupported -> string attribute form). -->
        <CollectionView Grid.Row="1" ItemsLayout="VerticalGrid, 3" EmptyView="Items loading simulation...">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Margin="6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
