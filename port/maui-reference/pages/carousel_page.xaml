<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.CarouselPagePage" Title="CarouselView"
             SafeAreaEdges="Container">
    <!-- This twin never set an ItemsSource, so the CarouselView had no items to realize and rendered
         completely blank in real MAUI (an ItemTemplate with nothing to bind it to paints nothing) —
         see docs/EQUIVALENCE_FINDINGS.md's retracted "carousel_page" quirk. Give it an inline x:Array
         (the established twin convention, e.g. collectionview.xaml) of a few cards so the purple-bordered
         "Card" ItemTemplate actually has something to lay out and paint. -->
    <CarouselView>
        <CarouselView.ItemsSource>
            <x:Array Type="{x:Type x:String}">
                <x:String>Card 1</x:String>
                <x:String>Card 2</x:String>
                <x:String>Card 3</x:String>
            </x:Array>
        </CarouselView.ItemsSource>
        <CarouselView.ItemTemplate>
            <DataTemplate>
                <Border Stroke="Purple" StrokeThickness="2" Padding="16">
                    <!-- BOUND, not the literal "Card" the original CoreGallery paints. The literal made
                         this page's own test unfalsifiable: the ItemsSource is Card 1 / Card 2 / Card 3,
                         so every item rendered IDENTICALLY, and paging from item 0 to item 1 produced a
                         byte-identical destination frame. carousel_page.toml drives exactly that swipe,
                         so the scenario could neither pass nor fail — a pixel diff cannot tell "did not
                         page" from "paged to a card that looks the same". It read as 0px on every desktop
                         lane and was nearly written up as an injector limitation.
                         {Binding .} is the established twin convention for a string ItemsSource (see
                         collectionview.xaml:36, adaptive_collection, cv_visual_states, empty_view_null)
                         and the loader supports it, so this lands on the MAUI column and the cpp_xaml
                         column from the same shared bytes. The card text is now the only thing that
                         changes when the control pages, which is exactly what the scenario measures. -->
                    <Label Text="{Binding .}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
            </DataTemplate>
        </CarouselView.ItemTemplate>
    </CarouselView>
</ContentPage>
