<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.CarouselPagePage" Title="CarouselView">
    <!-- This twin never set an ItemsSource, so the CarouselView had no items to realize and rendered
         completely blank in real MAUI (an ItemTemplate with nothing to bind it to paints nothing) —
         see docs/EQUIVALENCE_FINDINGS.md's retracted "carousel_page" quirk. Give it an inline x:Array
         (the established twin convention, e.g. collectionview.xaml) of a few cards so the purple-bordered
         "Card" ItemTemplate actually has something to lay out and paint. -->
    <CarouselView>
        <CarouselView.ItemsSource>
            <x:Array Type="{x:Type x:String}">
                <x:String>Card 1</x:String>
                <x:String>Card 2</x:String>
                <x:String>Card 3</x:String>
            </x:Array>
        </CarouselView.ItemsSource>
        <CarouselView.ItemTemplate>
            <DataTemplate>
                <Border Stroke="Purple" StrokeThickness="2" Padding="16">
                    <Label Text="Card" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
            </DataTemplate>
        </CarouselView.ItemTemplate>
    </CarouselView>
</ContentPage>
