<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.EmptyViewPage" Title="EmptyView (string)">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: the filter SearchBar -->
        <SearchBar Placeholder="Filter" Grid.Row="0" />

        <!-- Row 1: the CollectionView. EmptyView is unsupported (neither string nor element form), so the
             empty-state message is rendered as a plain sibling Label in the same cell instead. At rest the
             source is populated, so the item list shows over it. -->
        <Label Grid.Row="1" Text="No items match your filter." />
        <CollectionView Grid.Row="1">
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>cover1.jpg, 0</x:String>
                    <x:String>oasis.jpg, 1</x:String>
                    <x:String>photo.jpg, 2</x:String>
                    <x:String>Vegetables.jpg, 3</x:String>
                    <x:String>Fruits.jpg, 4</x:String>
                    <x:String>FlowerBuds.jpg, 5</x:String>
                    <x:String>Legumes.jpg, 6</x:String>
                    <x:String>cover1.jpg, 7</x:String>
                    <x:String>oasis.jpg, 8</x:String>
                    <x:String>photo.jpg, 9</x:String>
                    <x:String>Vegetables.jpg, 10</x:String>
                    <x:String>Fruits.jpg, 11</x:String>
                    <x:String>FlowerBuds.jpg, 12</x:String>
                    <x:String>Legumes.jpg, 13</x:String>
                    <x:String>cover1.jpg, 14</x:String>
                    <x:String>oasis.jpg, 15</x:String>
                    <x:String>photo.jpg, 16</x:String>
                    <x:String>Vegetables.jpg, 17</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Margin="6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
