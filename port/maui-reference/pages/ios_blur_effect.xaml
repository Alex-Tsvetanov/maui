<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.IosBlurEffectPage" Title="Blur Effect">
    <!-- The iOSSpecific VisualElement.BlurEffect knob is a platform-specific effect (no XAML dialect
         analog); the resting image + control column is reproduced. -->
    <VerticalStackLayout Margin="20" Spacing="12">
        <Image x:Name="BlurTarget" Source="oasis.jpg" />
        <Button x:Name="NoBlurButton" Text="No Blur" />
        <Button x:Name="ExtraLightButton" Text="Extra Light Blur" />
        <Button x:Name="LightButton" Text="Light Blur" />
        <Button x:Name="DarkButton" Text="Dark Blur" />
        <Label x:Name="Readout" Text="BlurEffect: ExtraLight" />
    </VerticalStackLayout>
</ContentPage>
