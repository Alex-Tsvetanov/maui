<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.EmptyViewNullPage" Title="EmptyView (null in XAML)">
    <!-- The CollectionView starts EMPTY (no ItemsSource), so the EmptyView is what renders at rest.
         The EmptyViewNullGallery oracle leaves EmptyView null in XAML and assigns the string
         "Nothing to display." from the code-behind ctor (useOnlyText default); the static twin folds
         that assignment into the string-form attribute. GridItemsLayout Span="3" Vertical (element
         form unsupported -> string attribute form). -->
    <CollectionView ItemsLayout="VerticalGrid, 3" EmptyView="Nothing to display.">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Label Text="{Binding .}" Margin="6" />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
