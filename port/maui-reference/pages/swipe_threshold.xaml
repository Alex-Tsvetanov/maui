<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.SwipeThresholdPage" Title="Horizontal SwipeThreshold Gallery">
    <!-- Twin of HorizontalSwipeThresholdGallery.xaml: four right-swipe blocks, each a SwipeView over a
         dark-blue (#2E249E) Grid, demonstrating Threshold vs SwipeMode. note: the loader registers only
         SwipeView.Content — the orange SwipeItem has no markup sink — so each SwipeView is DEGRADED to
         just its dark-blue content Grid, which is the RESTING appearance (the SwipeItem is hidden until a
         swipe). The slider readout is driven by another control, so static representative text is shown. -->
    <VerticalStackLayout Spacing="8">
        <Label Text="The Threshold property is only implemented for now on Android and iOS."
               BackgroundColor="Black" TextColor="White" />

        <Label Text="Default Threshold (Reveal Mode)" />
        <SwipeView HeightRequest="80">
            <SwipeView.Content>
                <Grid HeightRequest="80" BackgroundColor="#2E249E" />
            </SwipeView.Content>
        </SwipeView>

        <Label Text="Custom Threshold (only one SwipeItem using Reveal Mode)" />
        <Slider Minimum="50" Maximum="200" Value="80"
                MaximumTrackColor="Gray" MinimumTrackColor="#2E249E" ThumbColor="#2E249E" />
        <SwipeView HeightRequest="80">
            <SwipeView.Content>
                <Grid HeightRequest="80" BackgroundColor="#2E249E" />
            </SwipeView.Content>
        </SwipeView>

        <Label Text="Default Threshold (Execute Mode)" />
        <SwipeView HeightRequest="80">
            <SwipeView.Content>
                <Grid HeightRequest="80" BackgroundColor="#2E249E" />
            </SwipeView.Content>
        </SwipeView>

        <Label Text="Custom Threshold (only one SwipeItem using Execute Mode)" />
        <Slider Minimum="50" Maximum="300" Value="80"
                MaximumTrackColor="Gray" MinimumTrackColor="#2E249E" ThumbColor="#2E249E" />
        <SwipeView HeightRequest="80">
            <SwipeView.Content>
                <Grid HeightRequest="80" BackgroundColor="#2E249E" />
            </SwipeView.Content>
        </SwipeView>

        <Label Text="Reveal threshold=80 / Execute threshold=80" />
    </VerticalStackLayout>
</ContentPage>
