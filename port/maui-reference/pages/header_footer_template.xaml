<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.HeaderFooterTemplatePage" Title="Header/Footer (template)">
    <!-- Twin of HeaderFooterTemplate.xaml: a CollectionView whose HeaderTemplate/FooterTemplate are each a
         two-row Grid (an AspectFill cover Image + an overlaid bold AntiqueWhite time Label in row 0, a
         static "This Is A Header/Footer" Label in row 1), and whose ItemTemplate is the PhotoTemplate
         (an Image over a blue caption). The Header/Footer values are {Binding .} against a code-behind
         model (deferred): the {Binding CurrentTime} readout is replaced with static representative text,
         and the Image's TapGestureRecognizer (Command binding) is omitted (resting UI only). Item rows are
         inlined via x:Array; each row's Image {Binding Image} degrades to a fixed representative source. -->
    <CollectionView>
        <CollectionView.HeaderTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <Image Source="oasis.jpg" Aspect="AspectFill" HeightRequest="80" />
                    <Label Text="12:00:00 PM" TextColor="AntiqueWhite" HorizontalTextAlignment="Center"
                           FontAttributes="Bold" FontSize="36" />
                    <Label Grid.Row="1" Text="This Is A Header" />
                </Grid>
            </DataTemplate>
        </CollectionView.HeaderTemplate>

        <CollectionView.FooterTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <Image Source="cover1.jpg" Aspect="AspectFill" HeightRequest="50" />
                    <Label Text="12:00:00 PM" TextColor="AntiqueWhite" HorizontalTextAlignment="Center"
                           FontAttributes="Bold" FontSize="20" />
                    <Label Grid.Row="1" Text="This Is A Footer" />
                </Grid>
            </DataTemplate>
        </CollectionView.FooterTemplate>

        <CollectionView.ItemsSource>
            <x:Array Type="{x:Type x:String}">
                <x:String>cover1.jpg, 0</x:String>
                <x:String>oasis.jpg, 1</x:String>
                <x:String>photo.jpg, 2</x:String>
            </x:Array>
        </CollectionView.ItemsSource>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid WidthRequest="200" HeightRequest="100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Image Source="cover1.jpg" WidthRequest="100" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" Margin="2,5,2,2" />
                    <Label Grid.Row="1" Text="{Binding .}" FontSize="12" BackgroundColor="Blue"
                           HorizontalTextAlignment="Center" Margin="2,0,2,2" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
