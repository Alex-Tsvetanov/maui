<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.NestedCollectionPage" Title="Nested CollectionView">
    <!-- Twin of NestedCollectionViewGallery.xaml: a banner Label over an OUTER VerticalList CollectionView
         whose ItemTemplate root is an INNER HorizontalList CollectionView (HeightRequest=100, scroll bars
         Never), red-italic header bound to {Binding Title} and a blue caption cell bound to {Binding
         Caption}. note: the C# markup sets NO ItemsSource in XAML either (BindingContext = a
         NestedCollectionViewModel of 20 NestedItemSource is assigned in code-behind) — so this twin's
         code-behind (NestedCollectionPage.xaml.cs) does the same (deterministic counts, not the original's
         DateTime.Now/Random-seeded DemoFilteredItemSource, per AUTHORING.md's determinism rule), so the
         outer rows AND each inner nested list actually render. -->
    <VerticalStackLayout Spacing="12">
        <Label Text="It's CollectionViews all the way down." />
        <CollectionView x:Name="CollectionView" ItemsLayout="VerticalList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- The outer cell is a 2-column Grid: the red-italic Title in an Auto column 0, the
                         inner HorizontalList in the star column 1 — so the Title sits on the LEFT and the
                         captions flow to its right on the same line (real MAUI renders a horizontal CV's
                         Header on its leading/left edge, which this Grid reproduces on every backend; the
                         port's loader renders a horizontal CV's Header as a full-width TOP band, so the
                         earlier inner-CV Header form rendered the Title ABOVE the captions there). Matches
                         the green code-first source_cell twin. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                        <Label Grid.Column="0" Text="{Binding Title}" TextColor="Red"
                               FontAttributes="Italic" VerticalOptions="Start" />
                        <CollectionView Grid.Column="1"
                                        ItemsLayout="HorizontalList"
                                        HeightRequest="100"
                                        ItemsSource="{Binding Items}"
                                        VerticalOptions="Start"
                                        HorizontalScrollBarVisibility="Never"
                                        VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding Caption}" TextColor="Blue" FontSize="10" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
