<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.AppThemeBindingPage" Title="AppThemeBinding">
    <!-- Twin of AppThemeBindingPage.xaml: labels whose TextColor is set via {AppThemeBinding Light=…,
         Dark=…} — resolved against the application's requested theme at load and RE-APPLIED on every
         RequestedThemeChanged (both frameworks: C# AppThemeBinding / the port's theme-threaded loader).
         The second label's colors come from literal AppThemeBinding values rather than
         {StaticResource LightPrimaryColor} — the port has no <Color x:Key> resource-element hydration,
         so the resource indirection is degraded to the same resolved colors (Orange light / Teal dark).
         Headings inline-sized because {StaticResource Headline} is out of the twin scope. -->
    <VerticalStackLayout Margin="12">
        <Label Text="AppThemeBinding" FontSize="24" FontAttributes="Bold" />
        <Label Text="This text is green in light mode, and red in dark mode."
               TextColor="{AppThemeBinding Light=Green, Dark=Red}" />
        <Label Text="Using AppThemeBinding in a ResourceDictionary" FontSize="24" FontAttributes="Bold" />
        <Label Text="This text uses LightPrimaryColor (Orange) in light mode, and DarkPrimaryColor (Teal) in dark mode."
               TextColor="{AppThemeBinding Light=Orange, Dark=Teal}" />
    </VerticalStackLayout>
</ContentPage>
