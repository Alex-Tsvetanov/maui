<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.LabelPage" Title="Label">
    <VerticalStackLayout Spacing="6" Padding="12">
        <!-- Basic properties -->
        <Label Text="Defaults" />
        <Label Text="This text should be RED" TextColor="Red" />
        <Label Text="This has a solid CYAN background color" BackgroundColor="Cyan" />

        <!-- Horizontal text alignment -->
        <Label Text="This should be at the start of the line" HorizontalTextAlignment="Start" BackgroundColor="LightGray" />
        <Label Text="This should be at the center of the line" HorizontalTextAlignment="Center" BackgroundColor="Silver" />
        <Label Text="This should be at the end of the line" HorizontalTextAlignment="End" BackgroundColor="LightGray" />
        <Label Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." HorizontalTextAlignment="Justify" BackgroundColor="Silver" />

        <!-- Vertical text alignment -->
        <Label Text="This should be at the start" VerticalTextAlignment="Start" HeightRequest="100" BackgroundColor="LightGray" />
        <Label Text="This should be at the center" VerticalTextAlignment="Center" HeightRequest="100" BackgroundColor="Silver" />
        <Label Text="This should be at the bottom" VerticalTextAlignment="End" HeightRequest="100" BackgroundColor="LightGray" />

        <!-- Formatted text spans (W8 FormattedString element form). Span set + attribute placement
             follow the ORIGINAL LabelPage.xaml: "Colors" carries Cyan background + Navy text, "Big
             Font" is FontSize 20, the trailing "Plain old Text" is plain, and the separators are
             standalone plain-space spans (the gesture/uppercase/custom-font spans stay out of the
             reduced twin scope). -->
        <Label>
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Plain old Text" />
                    <Span Text=" " />
                    <Span Text="Colors" BackgroundColor="Cyan" TextColor="Navy" />
                    <Span Text=" " />
                    <Span Text="Strikethrough" TextDecorations="Strikethrough" />
                    <Span Text=" " />
                    <Span Text="Big Font" FontSize="20" />
                    <Span Text=" " />
                    <Span Text="Plain old Text" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <Button Text="Change Formatted String" />

        <!-- Maximum lines (the original's MaxLines=1 / MaxLines=2 lorem paragraphs) -->
        <Label MaxLines="1" Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />
        <Label MaxLines="2" Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />

        <!-- Line break mode (the original's six LineBreakMode lorem paragraphs) -->
        <Label LineBreakMode="NoWrap" Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />
        <Label LineBreakMode="WordWrap" Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />
        <Label LineBreakMode="HeadTruncation" Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />
        <Label LineBreakMode="MiddleTruncation" Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />
        <Label LineBreakMode="TailTruncation" Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />
        <Label LineBreakMode="CharacterWrap" Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />
    </VerticalStackLayout>
</ContentPage>
