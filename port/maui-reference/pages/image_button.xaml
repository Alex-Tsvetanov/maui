<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.ImageButtonPage" Title="ImageButton">
    <ScrollView>
        <VerticalStackLayout Spacing="6" Padding="12">
            <Label Text="0 ImageButton clicks" />

            <Label Text="AspectFit" />
            <ImageButton Source="cog.png" Aspect="AspectFit" BackgroundColor="Green" Padding="16,9,16,9" WidthRequest="200" />
            <Label Text="AspectFill" />
            <ImageButton Source="cog.png" Aspect="AspectFill" BackgroundColor="Green" Padding="16,9,16,9" WidthRequest="200" HeightRequest="100" />
            <Label Text="Fill" />
            <ImageButton Source="cog.png" Aspect="Fill" BackgroundColor="Green" Padding="16,9,16,9" WidthRequest="200" HeightRequest="100" />

            <Label Text="BorderColor + BorderWidth" />
            <ImageButton Source="cog.png" Aspect="AspectFit" BackgroundColor="Green" BorderColor="Red" BorderWidth="4" />
            <Slider Minimum="0" Maximum="20" Value="4" />

            <Label Text="CornerRadius = 0 / 10 / slider" />
            <ImageButton Source="cog.png" Aspect="AspectFit" CornerRadius="0" BackgroundColor="Purple" />
            <ImageButton Source="cog.png" Aspect="AspectFit" CornerRadius="10" BackgroundColor="Purple" />
            <ImageButton Source="cog.png" Aspect="AspectFit" CornerRadius="10" BackgroundColor="Purple" />
            <Slider Minimum="0" Maximum="60" Value="10" />

            <Label Text="Custom Size (click to resize)" />
            <ImageButton Source="dotnet_bot.png" WidthRequest="40" HeightRequest="40" />

            <Label Text="Padding (slider-driven)" />
            <ImageButton Source="cog.png" Aspect="AspectFit" BackgroundColor="Green" Padding="10" />
            <Slider Minimum="0" Maximum="60" Value="10" />

            <Label Text="Animated GIF" />
            <ImageButton Source="animated_heart.gif" />
            <Button Text="Use Online Source" />

            <Label Text="Background (toggle)" />
            <ImageButton Source="cog.png" Aspect="AspectFit" BackgroundColor="Green" Padding="0" />
            <Button Text="Update Background" />
            <Button Text="Remove Background" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
