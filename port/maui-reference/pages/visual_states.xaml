<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.VisualStatesPage" Title="VisualStates">
    <!-- Twin of VisualStatesPage.xaml: an Entry driven by a CommonStates VSM group (Normal=Lime,
         Disabled=Pink, Focused enlarges FontSize), an enabler Entry, and two Buttons driven by
         Normal/PointerOver(/Pressed) groups. The VisualStateManager / DataTrigger layers are interactive
         and omitted — only the resting appearance is shown. Per the port's ground-truth render the VSM
         entry rests in Normal (Lime background). -->
    <StackLayout Spacing="8">
        <Label Text="Entry with VisualStateManager:" />
        <Entry BackgroundColor="Lime" />
        <Label Text="Entry to enable 2nd Entry:" />
        <Entry Placeholder="Type something to enable 2nd Entry" />
        <Label Text="Button with Normal and PointerOver visual states:" />
        <Button Text="Hover me to see the state change" />
        <Label Text="Button with Normal, PointerOver, and Pressed visual states:" />
        <Label Text="The Normal and PointerOver states for this button are the same, so the PointerOver state returns the button to its base look after a click rather than leaving it Pressed." />
        <Button Text="Click me to see the state change and revert" />
    </StackLayout>
</ContentPage>
