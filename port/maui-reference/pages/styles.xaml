<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.StylesPage"
             Title="Styles">
    <VerticalStackLayout Spacing="12">
        <Label Text="This uses the (base) subtitle style"
               TextColor="#555555"
               CharacterSpacing="0.5" />
        <Label Text="This uses a custom style derived from the subtitle style (Pink wins)"
               TextColor="#FFC0CB"
               CharacterSpacing="0.5" />
        <Label Text="This uses no explicit style (descriptor defaults)" />
        <Button Text="Style Me"
                TextColor="#101010"
                CornerRadius="0"
                BorderColor="#C0C000"
                BorderWidth="2"
                BackgroundColor="LightGray" />
    </VerticalStackLayout>
</ContentPage>
