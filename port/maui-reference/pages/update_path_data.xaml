<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.UpdatePathDataPage" Title="Update Path Data Gallery">
    <!-- Twin of UpdatePathDataGallery.xaml: a Grid (*, Auto, Auto — RowSpacing 0) proving a Path repaints
         when its Data geometry is replaced. Row 0 = a black-stroked cubic Bézier
         ("M 10,100 C 10,300 300,-200 300,100", counter 0); Row 1 = a diagnostic readout label (port
         addition); Row 2 = the "Update Path Data" button. The counter/re-parse wiring is interactive and
         omitted — the initial (counter 0) resting state is shown. -->
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Path.Data geometry is unsupported; the cubic Bézier "M 10,100 C 10,300 300,-200 300,100" is
             approximated by a Polyline through the SAME four control points. Shipped MAUI renders this
             specific curve as straight zig-zag segments through its control points (verified against the
             maccatalyst capture — see update_path_data_page.hpp), so the faithful approximation is the
             control-point polyline (10,100)->(10,300)->(300,-200)->(300,100), matching the code-first render.
             (A prior S-curve/checkmark sampling did NOT match MAUI's actual render.) -->
        <Polyline Grid.Row="0" Stroke="Black" Points="10,100 10,300 300,-200 300,100" />
        <Label Grid.Row="1" Text="counter = 0 | Data: M 10,100 C 10,300 300,-200 300,100" />
        <Button Grid.Row="2" Text="Update Path Data" />
    </Grid>
</ContentPage>
