<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.CustomLayoutPage"
             Title="Custom Layout">
    <!-- Ports CustomLayoutPage.xaml: a developer-authored DockLayout docking six buttons
         (Top/Bottom/Left/Left/Right/Right) with LastChildFill="False". The custom DockLayout
         control and its DockLayout.Dock attached property are outside the supported markup
         surface, so this twin approximates the same six docked buttons inside a Grid whose
         rows/columns mirror the dock edges: Top button on top, Bottom on the bottom, two Left
         buttons in the left column and two Right buttons in the right column. -->
    <Grid RowDefinitions="50,*,50" ColumnDefinitions="60,60,*,80,80">
        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Top" HeightRequest="50"/>
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="Bottom" HeightRequest="50"/>
        <Button Grid.Row="1" Grid.Column="0" Text="Left" WidthRequest="60"/>
        <Button Grid.Row="1" Grid.Column="1" Text="Left" WidthRequest="60"/>
        <Button Grid.Row="1" Grid.Column="3" Text="Right" WidthRequest="80"/>
        <Button Grid.Row="1" Grid.Column="4" Text="Right" WidthRequest="80"/>
    </Grid>
</ContentPage>
