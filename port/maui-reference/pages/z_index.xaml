<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.ZIndexPage"
             Title="ZIndex">
    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Grid.Row="0">
            <Label Text="Z-Index of Label 5: 5" />
            <Stepper Minimum="0" Maximum="20" Increment="1" Value="5" />
        </HorizontalStackLayout>

        <Label Grid.Row="1" Text="This is Label 0, z-index 0" ZIndex="0"
               WidthRequest="200" HeightRequest="100"
               HorizontalOptions="Start" VerticalOptions="Start"
               BackgroundColor="Aquamarine" Margin="0,0,0,0" />
        <Label Grid.Row="1" Text="This is Label 1, z-index 1" ZIndex="1"
               WidthRequest="200" HeightRequest="100"
               HorizontalOptions="Start" VerticalOptions="Start"
               BackgroundColor="Orange" Margin="15,15,0,0" />
