               WidthRequest="200" HeightRequest="100"
               HorizontalOptions="Start" VerticalOptions="Start"
               BackgroundColor="Red" Margin="45,45,0,0" />
        <Label Grid.Row="1" Text="This is Label 4, z-index 4" ZIndex="4"
               WidthRequest="200" HeightRequest="100"
               HorizontalOptions="Start" VerticalOptions="Start"
               BackgroundColor="Green" Margin="60,60,0,0" />
