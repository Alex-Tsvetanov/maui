<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.CheckBoxPage" Title="CheckBox">
    <VerticalStackLayout Spacing="6" Padding="16">
        <Label Text="Default" FontSize="18" FontAttributes="Bold" />
        <CheckBox />
        <Label Text="Colored" FontSize="18" FontAttributes="Bold" />
        <CheckBox Color="Purple" />
        <Label Text="Disabled" FontSize="18" FontAttributes="Bold" />
        <CheckBox IsEnabled="False" />
        <Label Text="Disabled Colored" FontSize="18" FontAttributes="Bold" />
        <CheckBox IsEnabled="False" Color="Purple" IsChecked="True" />
        <Label Text="Change IsChecked" FontSize="18" FontAttributes="Bold" />
        <HorizontalStackLayout Spacing="6">
            <Button Text="Is green? False" TextColor="Red" />
            <CheckBox IsChecked="True" Color="Red" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
