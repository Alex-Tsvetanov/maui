<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.EmptyViewViewPage" Title="EmptyView (view)">
    <Grid Padding="12" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: the "Filter" SearchBar (SearchCommand omitted) -->
        <SearchBar Grid.Row="0" Placeholder="Filter" />

        <!-- Row 1: the CollectionView (GridItemsLayout Span=3, Vertical) with the element-form EmptyView
             (the EmptyViewViewGallery oracle's two-label StackLayout). At rest the source is full, so
             the EmptyView does not render — matching real MAUI. -->
        <CollectionView Grid.Row="1" ItemsLayout="VerticalGrid, 3">
            <CollectionView.EmptyView>
                <StackLayout>
                    <Label Text="No results matched your filter."
                           FontAttributes="Bold" FontSize="18" Margin="10,25,10,10"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Maybe try a broader filter?"
                           FontAttributes="Italic" FontSize="12"
                           HorizontalTextAlignment="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>cover1.jpg, 0</x:String>
                    <x:String>oasis.jpg, 1</x:String>
                    <x:String>photo.jpg, 2</x:String>
                    <x:String>Vegetables.jpg, 3</x:String>
                    <x:String>Fruits.jpg, 4</x:String>
                    <x:String>FlowerBuds.jpg, 5</x:String>
                    <x:String>Legumes.jpg, 6</x:String>
                    <x:String>cover1.jpg, 7</x:String>
                    <x:String>oasis.jpg, 8</x:String>
                    <x:String>photo.jpg, 9</x:String>
                    <x:String>Vegetables.jpg, 10</x:String>
                    <x:String>Fruits.jpg, 11</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Margin="6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
