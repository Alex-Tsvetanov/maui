<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.BehaviorsPage" Title="Behaviors">
    <!-- Twin of BehaviorsPage.xaml: a headline label + an Entry that (in C#) carries a
         NumericValidationBehavior recoloring the text red when it isn't a valid double. note: the loader
         registers no Entry.Behaviors sink and no custom behaviors: namespace type, and behaviors are
         code-only anyway, so the <Entry.Behaviors> element is DEGRADED away — the visible rest state is
         just the placeholder Entry, which is exactly what the page shows before any input. Headline
         inline-sized (FontSize 32) since {StaticResource Headline} is out of the twin scope. -->
    <VerticalStackLayout Margin="12">
        <Label Text="Red when the number isn't valid" FontSize="32" />
        <Entry Placeholder="Enter a System.Double" />
    </VerticalStackLayout>
</ContentPage>
