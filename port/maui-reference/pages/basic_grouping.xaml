<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.BasicGroupingPage" Title="Basic Grouping">
    <!-- Twin of BasicGrouping.xaml: a grouped CollectionView (IsGrouped=True) with a view-level Header +
         Footer and three DataTemplates — ItemTemplate ({Binding Name}), GroupHeaderTemplate (LightGreen
         bold, {Binding Name}) and GroupFooterTemplate (Orange, {Binding Count, StringFormat}). note: the
         C# markup itself sets NO ItemsSource — SuperTeams() is assigned in code-behind — so, like the
         original, this static twin renders the header/footer strings + the (unused) template definitions
         with no grouped rows. Faithful to the markup. -->
    <CollectionView IsGrouped="True" Header="This is a header" Footer="Hey, a footer.">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Name}" Margin="5,0,0,0" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Label Text="{Binding Name}" BackgroundColor="LightGreen" FontSize="16" FontAttributes="Bold" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.GroupFooterTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Count, StringFormat='Total members: {0}'}" BackgroundColor="Orange" Margin="0,0,0,15" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.GroupFooterTemplate>
    </CollectionView>
</ContentPage>
