<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.DragDropPage" Title="Drag and drop">
    <!-- DragGestureRecognizer / DropGestureRecognizer omitted (gesture layer). Resting UI only:
         the two color lists + the position readouts. -->
    <VerticalStackLayout Spacing="12">
        <Label Text="All colors (drag a swatch to the rainbow list):" />
        <!-- Both stacks are DROP targets and every swatch is a DRAG source, matching the builder
             twin (drag_drop_page.hpp). The structure-equivalence diff named the omission as
             gestures="1[drop]" on each stack and gestures="1[drag]" on each BoxView. Commands and
             handlers stay omitted per the dialect — only the recognizers are declared. -->
        <VerticalStackLayout Spacing="4">
            <VerticalStackLayout.GestureRecognizers>
                <DropGestureRecognizer AllowDrop="True" />
            </VerticalStackLayout.GestureRecognizers>
            <BoxView Color="Red" HeightRequest="40">
                <BoxView.GestureRecognizers>
                    <DragGestureRecognizer CanDrag="True" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Color="Orange" HeightRequest="40">
                <BoxView.GestureRecognizers>
                    <DragGestureRecognizer CanDrag="True" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Color="Yellow" HeightRequest="40">
                <BoxView.GestureRecognizers>
                    <DragGestureRecognizer CanDrag="True" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Color="Green" HeightRequest="40">
                <BoxView.GestureRecognizers>
                    <DragGestureRecognizer CanDrag="True" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Color="Blue" HeightRequest="40">
                <BoxView.GestureRecognizers>
                    <DragGestureRecognizer CanDrag="True" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Color="Indigo" HeightRequest="40">
                <BoxView.GestureRecognizers>
                    <DragGestureRecognizer CanDrag="True" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Color="Violet" HeightRequest="40">
                <BoxView.GestureRecognizers>
                    <DragGestureRecognizer CanDrag="True" />
                </BoxView.GestureRecognizers>
            </BoxView>
        </VerticalStackLayout>

        <Label Text="Rainbow:" />
        <VerticalStackLayout Spacing="4">
            <VerticalStackLayout.GestureRecognizers>
                <DropGestureRecognizer AllowDrop="True" />
            </VerticalStackLayout.GestureRecognizers>
        </VerticalStackLayout>

        <Label Text="Drag start position relative to..." />
        <Label Text="" />
        <Label Text="Drag position relative to..." />
        <Label Text="" />
        <Label Text="Drop position relative to..." />
        <Label Text="" />
        <Label Text="Move: (none yet)" />
    </VerticalStackLayout>
</ContentPage>
