<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.ActivityIndicatorPage" Title="ActivityIndicator">
    <VerticalStackLayout Spacing="6" Padding="12">
        <Label Text="Default" FontSize="18" FontAttributes="Bold" />
        <ActivityIndicator IsRunning="True" />
        <Label Text="Color" FontSize="18" FontAttributes="Bold" />
        <ActivityIndicator IsRunning="True" Color="CornflowerBlue" />
        <Label Text="BackgroundColor=Yellow" FontSize="18" FontAttributes="Bold" />
        <ActivityIndicator IsRunning="True" BackgroundColor="Yellow" />
        <Label Text="Larger" FontSize="18" FontAttributes="Bold" />
        <ActivityIndicator IsRunning="True" WidthRequest="150" HeightRequest="150" />
        <Label Text="Smaller" FontSize="18" FontAttributes="Bold" />
        <ActivityIndicator IsRunning="True" WidthRequest="10" HeightRequest="10" />
        <Label Text="Not Running" FontSize="18" FontAttributes="Bold" />
        <ActivityIndicator IsRunning="False" />
        <Label Text="- End of page -" />
    </VerticalStackLayout>
</ContentPage>
