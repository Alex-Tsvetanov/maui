<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.MeasureFirstStrategyPage" Title="MeasureFirstStrategy">
    <!-- Twin of MeasureFirstStrategy.xaml: the explanatory Label over a grouped CollectionView
         (ItemSizingStrategy=MeasureFirstItem, IsGrouped=True) with three DataTemplates — ItemTemplate
         ({Binding Name}), GroupHeaderTemplate (LightGreen bold 16, {Binding Name}) and GroupFooterTemplate
         (Orange, {Binding Count, StringFormat}). The code-first port adds an observable Toggle button +
         strategy readout; those are reproduced as resting UI. Grouped SuperTeams() source is assigned in
         code (like basic_grouping), so, per the supported dialect, no grouped rows are inlined. -->
    <VerticalStackLayout Spacing="12">
        <Label Text="Using ItemSizingStrategy.MeasureFirstItem. On scrolling, some items may disappear; this is a current known issue." />
        <Button Text="Toggle Sizing Strategy" />
        <Label Text="ItemSizingStrategy: MeasureFirstItem" />
        <CollectionView ItemSizingStrategy="MeasureFirstItem" IsGrouped="True">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout>
                        <Label Text="{Binding Name}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}" TextColor="LightGreen" FontSize="16" FontAttributes="Bold" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.GroupFooterTemplate>
                <DataTemplate>
                    <Label Text="{Binding Count, StringFormat='Total members: {0}'}" TextColor="Orange" />
                </DataTemplate>
            </CollectionView.GroupFooterTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
