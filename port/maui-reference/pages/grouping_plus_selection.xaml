<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.GroupingPlusSelectionPage" Title="Grouping Plus Selection">
    <!-- Twin of GroupingPlusSelection.xaml: a grouped CollectionView (IsGrouped=True) with
         SelectionMode=Single and the three DataTemplates — ItemTemplate ({Binding Name}),
         GroupHeaderTemplate (LightGreen bold {Binding Name}) and GroupFooterTemplate (Orange
         {Binding Count, StringFormat}). Unlike BasicGrouping/GridGrouping this page sets NO view-level
         Header/Footer. note: the C# markup sets NO ItemsSource in XAML either — SuperTeams() is assigned
         in code-behind — so this twin's code-behind (GroupingPlusSelectionPage.xaml.cs) does the same,
         giving CollectionView.ItemsSource a SuperTeams() instance so the grouped rows actually render. -->
    <CollectionView x:Name="CollectionView" IsGrouped="True" SelectionMode="Single">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Name}" Margin="5,0,0,0" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Label Text="{Binding Name}" BackgroundColor="LightGreen" FontSize="16" FontAttributes="Bold" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.GroupFooterTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Count, StringFormat='Total members: {0}'}" BackgroundColor="Orange" Margin="0,0,0,15" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.GroupFooterTemplate>
    </CollectionView>
</ContentPage>
