<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.EllipseGalleryPage" Title="Ellipse Gallery">
    <ScrollView>
        <StackLayout Padding="12">
            <!-- x:Name="ellipse": red fill, 150x50. Caption is verbatim C# ("A basic Rectangle"). -->
            <Label Text="A basic Rectangle" />
            <Ellipse Fill="Red" WidthRequest="150" HeightRequest="50" />

            <!-- A Circle: red stroke 4, no fill, 150x150. -->
            <Label Text="A Circle" />
            <Ellipse Stroke="Red" StrokeThickness="4" WidthRequest="150" HeightRequest="150" />

            <!-- An Ellipse with stroke: red stroke 4, no fill, 150x50. -->
            <Label Text="An Ellipse with stroke" />
            <Ellipse Stroke="Red" StrokeThickness="4" WidthRequest="150" HeightRequest="50" />

            <!-- The same plus a dark-blue fill (shares the caption above), 150x50. -->
            <Ellipse Fill="DarkBlue" Stroke="Red" StrokeThickness="4" WidthRequest="150" HeightRequest="50" />

            <!-- An Ellipse with stroke dash: dark-blue fill, red dashed stroke (1,1 / offset 6), 150x50. -->
            <Label Text="An Ellipse with stroke dash" />
            <Ellipse Fill="DarkBlue" Stroke="Red" StrokeThickness="4"
                     StrokeDashArray="1,1" StrokeDashOffset="6"
                     WidthRequest="150" HeightRequest="50" />
        </StackLayout>
    </ScrollView>
</ContentPage>
