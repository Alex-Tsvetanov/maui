<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.TableViewPage"
             Title="TableView">
    <TableView Intent="Settings" HasUnevenRows="True">
        <TableRoot>
            <TableSection Title="Profile">
                <TextCell Text="Account" Detail="alex@example.com" TextColor="Navy" />
                <EntryCell Label="Name" Placeholder="Enter your name" Text="Alex" />
            </TableSection>
            <TableSection Title="Preferences">
                <SwitchCell Text="Notifications" On="True" />
                <SwitchCell Text="Dark mode" On="False" OnColor="MediumPurple" />
            </TableSection>
            <TableSection Title="Custom">
                <ViewCell>
                    <HorizontalStackLayout Spacing="8" Padding="12,6">
                        <Label Text="Status" TextColor="Gray" />
                        <Label Text="Active" TextColor="Green" />
                    </HorizontalStackLayout>
                </ViewCell>
            </TableSection>
        </TableRoot>
    </TableView>
</ContentPage>
