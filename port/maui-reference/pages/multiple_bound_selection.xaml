<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.MultipleBoundSelectionPage" Title="Multiple Bound Selection">
    <!-- Twin of MultipleBoundSelection.xaml: an instructions Label, a "Selected: {0}" readout, a
         SelectionMode=Multiple CollectionView (Header="This is the header", four "Item n" captions) and
         three action buttons (Clear and Add / Reset / Direct Update). Selection binding + mutation paths
         are interactive; the resting readout shows the seeded selection (Item 1, Item 2). -->
    <VerticalStackLayout Spacing="2">
        <Label Text="The selected items in the CollectionView should always match the 'Selected' Label below. If it does not, this test has failed." />
        <Label Text="Selected: Item 1, Item 2" />
        <CollectionView Header="This is the header" SelectionMode="Multiple">
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Item 0</x:String>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
            <!-- Seed the resting selection so MAUI + the loader (xaml column) draw the persistent selection
                 band on Item 1/Item 2 — matching the "Selected: Item 1, Item 2" readout and the code-first
                 render (ruling 9: iOS/Android draw the band). The twin previously omitted this, so only the
                 code-first column showed the selection. -->
            <CollectionView.SelectedItems>
                <!-- DIRECT <x:String> CHILDREN, NOT A WRAPPING <x:Array> — see preselected_items.xaml for the
                     XamlC ladder that makes the array form add the ARRAY as one entry and select nothing. -->
                <x:String>Item 1</x:String>
                <x:String>Item 2</x:String>
            </CollectionView.SelectedItems>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Clear and Add" />
        <Button Text="Reset" />
        <Button Text="Direct Update" />
    </VerticalStackLayout>
</ContentPage>
