<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.PickerPage" Title="Picker">
    <ScrollView>
        <VerticalStackLayout Spacing="6" Padding="12">
            <Label Text="Basic" />
            <Picker Title="Select an item">
                <Picker.Items>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                    <x:String>Item 4</x:String>
                    <x:String>Item 5</x:String>
                    <x:String>Item 6</x:String>
                    <x:String>Item 7</x:String>
                    <x:String>Item 8</x:String>
                    <x:String>Item 9</x:String>
                    <x:String>Item 10</x:String>
                    <x:String>Item 11</x:String>
                    <x:String>Item 12</x:String>
                    <x:String>Item 13</x:String>
                    <x:String>Item 14</x:String>
                    <x:String>Item 15</x:String>
                    <x:String>Item 16</x:String>
                    <x:String>Item 17</x:String>
                    <x:String>Item 18</x:String>
                    <x:String>Item 19</x:String>
                    <x:String>Item 20</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="SelectedIndex=1" />
            <Picker Title="Select an item" SelectedIndex="1">
                <Picker.Items>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="SelectedIndexChanged" />
            <Picker Title="Select an item" SelectedIndex="1">
                <Picker.Items>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="Selected: (none)" />
            <Label Text="TextColor=Blue" />
            <Picker Title="Select an item" TextColor="Blue">
                <Picker.Items>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="TitleColor=Blue" />
            <Picker Title="Select an item" TitleColor="Blue">
                <Picker.Items>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="FontAttributes=Italic + BackgroundColor=Yellow" />
            <Picker Title="Select an item" FontAttributes="Italic" BackgroundColor="Yellow">
                <Picker.Items>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="Dynamic add items to the Picker" />
            <Picker Title="The picker should have 3 items.">
                <Picker.Items>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </Picker.Items>
            </Picker>
            <Button Text="Clear Items" />
            <Button Text="Add Items" />
            <Button Text="Replace Items" />
            <Label Text="Items (markup) + BackgroundColor=Green" />
            <Picker TextColor="White" BackgroundColor="Green" SelectedIndex="0">
                <Picker.Items>
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </Picker.Items>
            </Picker>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
