<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.GridGroupingPage" Title="Grid Grouping"
             SafeAreaEdges="Container">
    <!-- Twin of GridGrouping.xaml: a grouped CollectionView (IsGrouped=True) over a GridItemsLayout
         (Span=2, Vertical) with a view-level Header + Footer string and three DataTemplates —
         ItemTemplate ({Binding Name}), GroupHeaderTemplate (LightGreen bold {Binding Name}) and
         GroupFooterTemplate (Orange {Binding Count, StringFormat}). The GridItemsLayout element form
         degrades to the ItemsLayout string attribute (HorizontalItemSpacing is lost — acceptable). note:
         the C# markup sets NO ItemsSource in XAML either — SuperTeams() is assigned in code-behind — so
         this twin's code-behind (GridGroupingPage.xaml.cs) does the same, giving CollectionView.ItemsSource
         a SuperTeams() instance so the grouped rows actually render. -->
    <CollectionView x:Name="CollectionView" IsGrouped="True" Header="This is a header" Footer="This is a footer." ItemsLayout="VerticalGrid, 2">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Name}" Margin="5,0,0,0" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Label Text="{Binding Name}" BackgroundColor="LightGreen" FontSize="16" FontAttributes="Bold" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.GroupFooterTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding Count, StringFormat='Total members: {0}'}" BackgroundColor="Orange" Margin="0,0,0,15" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.GroupFooterTemplate>
    </CollectionView>
</ContentPage>
