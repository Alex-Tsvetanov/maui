<!-- KNOWN PORT GAP (do not "fix" the twin back): the "Clip" section's BoxView carries an
     EllipseGeometry clip in the original C# sample. A Geometry is not an IShape, and the port's
     view::set_clip seam takes a graphics::i_shape with no Geometry-as-clip primitive behind it, so
     that one BoxView is deliberately rendered as a plain pink block on ALL THREE columns. This is a
     degraded twin representing a REAL missing capability (PORT-MUST-EXPRESS-IT), not an oversight.
     The "Shadow" section is NOT degraded: <Shadow> was restored once the loader learned to mint it. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.BoxViewPage" Title="BoxView">
    <ScrollView>
        <VerticalStackLayout Spacing="6" Padding="12">
            <Label Text="Default" />
            <BoxView BackgroundColor="CornflowerBlue" WidthRequest="160" HeightRequest="160" />

            <Label Text="Using Color" />
            <BoxView Color="Purple" WidthRequest="160" HeightRequest="160" />

            <Label Text="Background" />
            <BoxView WidthRequest="160" HeightRequest="160">
                <BoxView.Background>
                    <LinearGradientBrush EndPoint="1,0">
                        <GradientStop Color="Yellow" Offset="0.1" />
                        <GradientStop Color="Green" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Label Text="Using CornerRadius" />
            <BoxView Color="LightGreen" CornerRadius="10" WidthRequest="160" HeightRequest="160" />

            <Label Text="Using Complex CornerRadius" />
            <BoxView Color="Orange" CornerRadius="10,0,5,20" WidthRequest="160" HeightRequest="160" />

            <Label Text="Using Opacity" />
            <BoxView Color="Orange" Opacity="0.5" WidthRequest="160" HeightRequest="160" />

            <Label Text="Clip" />
            <BoxView Color="Pink" WidthRequest="160" HeightRequest="160" />

            <Label Text="Shadow" />
            <BoxView Color="Pink" WidthRequest="160" HeightRequest="160">
                <BoxView.Shadow>
                    <Shadow Brush="Red" Radius="6" Offset="6,6" />
                </BoxView.Shadow>
            </BoxView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
