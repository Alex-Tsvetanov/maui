<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.IosEntryPage" Title="Entry FontSize and CursorColor">
    <!-- The iOSSpecific Entry knobs (AdjustsFontSizeToFitWidth, CursorColor) are platform attached
         properties (no XAML dialect analog); the resting Entry + toggle button are reproduced. -->
    <VerticalStackLayout Spacing="12">
        <Entry Placeholder="Enter text here to see the font size change" FontSize="22" />
        <Button Text="Toggle AdjustsFontSizeToFitWidth" />
    </VerticalStackLayout>
</ContentPage>
