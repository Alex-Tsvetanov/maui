<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.FontsPage" Title="Fonts">
    <ScrollView>
        <VerticalStackLayout Spacing="8" Padding="16">
            <!-- Title/Subtitle/Header/Body/Caption at explicit decreasing FontSizes -->
            <Label Text="Title" FontSize="34" />
            <Label Text="Subtitle" FontSize="28" />
            <Label Text="Header" FontSize="23" />
            <Label Text="Body" FontSize="22" />
            <Label Text="Caption" FontSize="18" />

            <!-- FontAttributes Bold / Italic / Bold+Italic at the default size -->
            <Label Text="Bold" FontAttributes="Bold" />
            <Label Text="Italic" FontAttributes="Italic" />
            <Label Text="Bold + Italic" FontAttributes="Bold,Italic" />

            <!-- CharacterSpacing 4.0 (default size) -->
            <Label Text="Character spacing 4.0" CharacterSpacing="4.0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
