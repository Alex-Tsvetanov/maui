<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.PathTransformStringPage" Title="Path Transform from string Gallery">
    <!-- Twin of PathTransformStringGallery.xaml: a ScrollView over a StackLayout (Padding 12) showing the
         SAME two-figure Path geometry twice — the first carrying RenderTransform="0.75 0 0 0.75 0 0" (a
         uniform 0.75 scale), the second plain. The implicit <Style TargetType="Path"> (100x100, black
         Stroke, StrokeThickness 4) is inlined on each Path per the dialect (resource style elements are not
         hydrated). Each Path.Data is the object-element PathGeometry of two closed triangles. -->
    <ScrollView>
        <StackLayout Padding="12">
            <!-- Path.Data geometry (and RenderTransform on shapes) are unsupported; each two-closed-triangle
                 PathGeometry degrades to two overlaid Polygons in a Grid (one per closed PathFigure), which
                 gives the same resting silhouette. The RenderTransform 0.75 scale is dropped (transforms are
                 not on the supported shape surface). -->
            <Label Text="Without RenderTransform" />
            <Grid WidthRequest="100" HeightRequest="100">
                <Polygon Points="10,100 100,100 100,50" Stroke="Black" StrokeThickness="4" />
                <Polygon Points="10,10 100,10 100,40" Stroke="Black" StrokeThickness="4" />
            </Grid>
            <Label Text="With RenderTransform" />
            <Grid WidthRequest="100" HeightRequest="100">
                <Polygon Points="10,100 100,100 100,50" Stroke="Black" StrokeThickness="4" />
                <Polygon Points="10,10 100,10 100,40" Stroke="Black" StrokeThickness="4" />
            </Grid>
        </StackLayout>
    </ScrollView>
</ContentPage>
