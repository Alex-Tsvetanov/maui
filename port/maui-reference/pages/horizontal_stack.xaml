<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.HorizontalStackPage" Title="HorizontalStackLayout">
    <HorizontalStackLayout Padding="12" Spacing="6">
        <BoxView Color="Red" WidthRequest="40" HeightRequest="40" />
        <BoxView Color="Yellow" WidthRequest="40" HeightRequest="40" />
        <BoxView Color="Blue" WidthRequest="40" HeightRequest="40" />
        <BoxView Color="Green" WidthRequest="40" HeightRequest="40" />
        <BoxView Color="Orange" WidthRequest="40" HeightRequest="40" />
        <BoxView Color="Purple" WidthRequest="40" HeightRequest="40" />
    </HorizontalStackLayout>
</ContentPage>
