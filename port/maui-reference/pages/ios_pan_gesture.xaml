<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.IosPanGesturePage" Title="Pan Gesture Recognizer">
    <!-- The PanGestureRecognizer on the target Label and the iOSSpecific Application simultaneous-
         recognition knob are interaction/platform concerns (omitted at rest); the resting labels +
         toggle button are reproduced. -->
    <VerticalStackLayout Margin="20" Spacing="12">
        <Label Text="Pan the target. If you pan it, this Label will change." FontAttributes="Bold" />
        <Button Text="Toggle Simultaneous Gesture Recognition" />
        <!-- The PanGestureRecognizer is declared (the builder twin attaches one here); only its EVENT
             handler stays omitted per the dialect. Named by the structure-equivalence diff as
             label text="Pan target" gestures="1[pan]" against a bare label. -->
        <Label Text="Pan target">
            <Label.GestureRecognizers>
                <PanGestureRecognizer />
            </Label.GestureRecognizers>
        </Label>
        <Label Text="SimultaneousRecognition: false" />
    </VerticalStackLayout>
</ContentPage>
