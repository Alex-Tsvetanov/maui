<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.FormattedTextPage"
             Title="Formatted text">
  <VerticalStackLayout Spacing="12">
    <Label FontFamily="Helvetica" FontSize="16">
      <Label.FormattedText>
        <FormattedString>
          <Span Text="Bold red " FontAttributes="Bold" TextColor="#DB3345" />
          <Span Text="italic underlined " FontAttributes="Italic" TextDecorations="Underline" />
          <Span Text="k e r n e d" CharacterSpacing="3" />
        </FormattedString>
      </Label.FormattedText>
    </Label>
    <Label Text="Plain text label" />
  </VerticalStackLayout>
</ContentPage>
