<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.PreselectedItemsPage" Title="Preselected Items">
    <!-- Twin of PreselectedItemsGallery.xaml: a StackLayout (Margin 10) with an instructions Label and a
         CollectionView (Header="This is the header", GridItemsLayout Span 4 Vertical, Multiple selection).
         The code-behind preselects items 2/4/5; the headless port surfaces those captions via a readout —
         mirrored statically here. The PhotoTemplate collapses to the Caption label per the dialect. -->
    <StackLayout Margin="10" Spacing="2">
        <Label Text="The CollectionView below should have several items already selected." />
        <Label Text="Preselected: photo.jpg, 2, Fruits.jpg, 4, FlowerBuds.jpg, 5" />
        <CollectionView Header="This is the header" SelectionMode="Multiple" ItemsLayout="VerticalGrid, 4">
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>cover1.jpg, 0</x:String>
                    <x:String>oasis.jpg, 1</x:String>
                    <x:String>photo.jpg, 2</x:String>
                    <x:String>Vegetables.jpg, 3</x:String>
