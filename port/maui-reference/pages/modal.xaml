<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.ModalPage" Title="Modal Page 0">
    <!-- Twin of ModalPage.xaml: a "Modal Page n" label over five modal/navigation buttons, plus a stack-
         depth readout (the code-first port's observable analog of the ambient modal stack). The C# Grid
         (RowDefinitions=Auto×6) lays out identically to a vertical stack. Interactivity (push/pop) is
         omitted; the resting readout reflects the empty modal stack. -->
    <VerticalStackLayout Spacing="8">
        <Label Text="Modal Page 1" />
        <Button Text="Push Page" />
        <Button Text="Push Modal Page" />
        <Button Text="Push Modal Navigation Page" />
        <Button Text="Push Modal Flyout Page" />
        <Button Text="Pop Modal Page" IsEnabled="False" />
        <Label Text="Modal depth: 0  |  page stack depth: 1" />
    </VerticalStackLayout>
</ContentPage>
