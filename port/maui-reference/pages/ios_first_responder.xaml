<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.IosFirstResponderPage" Title="VisualElement first responder">
    <!-- The iOSSpecific VisualElement.CanBecomeFirstResponder knob on the second OK button is a platform
         attached property (no XAML dialect analog); the resting view content is reproduced. -->
    <VerticalStackLayout Margin="10" Spacing="10">
        <Label Text="Click in the first Entry to make the keyboard appear. Then click OK and the keyboard should disappear." />
        <Entry Placeholder="First Entry" />
        <Button Text="OK" />

        <Label Text="Click in the second Entry to make the keyboard appear. Then click OK and the keyboard shouldn't disappear." />
        <Entry Placeholder="Second Entry" />
        <Button Text="OK" />

        <HorizontalStackLayout Spacing="8">
            <Button Text="Focus First" />
            <Button Text="Focus Second" />
        </HorizontalStackLayout>

        <Label Text="First IsFocused: false&#10;Second IsFocused: false&#10;Second OK CanBecomeFirstResponder: true" />
    </VerticalStackLayout>
</ContentPage>
