<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.IosSliderUpdateOnTapPage" Title="Slider Update on Tap">
    <!-- Twin of iOSSliderUpdateOnTapPage.xaml: an instruction Label, a Slider (iOS UpdateOnTap knob,
         omitted: platform-config, no markup sink) and a toggle Button. StackLayout Margin="20". -->
    <VerticalStackLayout Spacing="12" Margin="20">
        <Label Text="Tap on the Slider bar to move the thumb." />
        <Slider />
        <Button Text="Toggle Update on Tap" />
    </VerticalStackLayout>
</ContentPage>
