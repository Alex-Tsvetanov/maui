<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.ShapesPage" Title="Shapes">
    <!-- Twin of the shapes demo (ComparePages.Shapes): a scrolled vertical stack of four bold-captioned,
         Start-aligned shapes at fixed sizes — an Ellipse (Fill Red, Stroke DarkBlue 4, 150x60), a
         RoundRectangle (Fill DarkBlue, RadiusX 12 / RadiusY 24, 150x60), an EvenOdd pentagram Polygon
         (Fill Blue, Stroke Red 2, 100x100), and a Line (40,0)->(0,80), Stroke Purple 2, 120x80. Fully
         faithful. -->
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <Label Text="Ellipse" FontAttributes="Bold" />
            <Ellipse Fill="Red" Stroke="DarkBlue" StrokeThickness="4"
                     WidthRequest="150" HeightRequest="60" HorizontalOptions="Start" />

            <Label Text="RoundRectangle" FontAttributes="Bold" />
            <Rectangle Fill="DarkBlue" RadiusX="12" RadiusY="24"
                       WidthRequest="150" HeightRequest="60" HorizontalOptions="Start" />

            <Label Text="EvenOdd Polygon (pentagram)" FontAttributes="Bold" />
            <Polygon Points="10,100 50,0 90,100 0,35 100,35"
                     Fill="Blue" Stroke="Red" StrokeThickness="2" FillRule="EvenOdd"
                     WidthRequest="100" HeightRequest="100" HorizontalOptions="Start" />

            <Label Text="Line" FontAttributes="Bold" />
            <Line X1="40" Y1="0" X2="0" Y2="80" Stroke="Purple" StrokeThickness="2"
                  WidthRequest="120" HeightRequest="80" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
