<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.EmptyViewSwapPage" Title="EmptyView Swap">
    <Grid Padding="12" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: the "Filter" SearchBar -->
        <SearchBar Grid.Row="0" Placeholder="Filter" />

        <!-- Row 1: the "Toggle Between EmptyViews" Label + Switch -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Label Text="Toggle Between EmptyViews" VerticalTextAlignment="Center" />
            <Switch />
        </HorizontalStackLayout>

        <!-- Row 2: the Clear / Fill toggle buttons -->
        <HorizontalStackLayout Grid.Row="2" Spacing="12">
            <Button Text="Clear" />
            <Button Text="Fill" />
        </HorizontalStackLayout>

        <!-- Row 3: the CollectionView (3-span vertical grid of caption labels). The oracle's switch
             swaps EmptyView between the EmptyView1/EmptyView2 ContentView resources from code-behind;
             the switch starts OFF, so the AT-REST EmptyView is EmptyView2 ("Nothing to see here."),
             authored here in the element form. (EmptyView2's coffee.png Image is omitted — no bundled
             image assets in the static twin; the EmptyView does not render at rest anyway, since the
             source is populated.) -->
        <CollectionView Grid.Row="3" ItemsLayout="VerticalGrid, 3">
            <CollectionView.EmptyView>
                <StackLayout>
                    <Label Text="Nothing to see here."
                           FontAttributes="Bold" FontSize="18" Margin="10,25,10,10"
                           HorizontalTextAlignment="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>cover1.jpg, 0</x:String>
                    <x:String>oasis.jpg, 1</x:String>
                    <x:String>photo.jpg, 2</x:String>
                    <x:String>Vegetables.jpg, 3</x:String>
                    <x:String>Fruits.jpg, 4</x:String>
                    <x:String>FlowerBuds.jpg, 5</x:String>
                    <x:String>Legumes.jpg, 6</x:String>
                    <x:String>cover1.jpg, 7</x:String>
                    <x:String>oasis.jpg, 8</x:String>
                    <x:String>photo.jpg, 9</x:String>
                    <x:String>Vegetables.jpg, 10</x:String>
                    <x:String>Fruits.jpg, 11</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Margin="6" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
