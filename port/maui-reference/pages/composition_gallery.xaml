<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReference.Pages.CompositionGalleryPage" Title="Composition Gallery">
    <!-- Twin of CompositionGallery.xaml: a StackLayout with two Beige 250x250 Grids composing overlapping
         shapes to show layering/blending.
           Grid 1 — four half-transparent (Opacity .5) shapes in one cell: a blue diagonal stroke, a thick
                    red diagonal over it, a green filled triangle, and a yellow filled circle on top.
           Grid 2 — three default-stroked hairline Lines meeting at (100,100): red, blue, green.
         DEGRADES: the loader does not register Path.Data (geometry element), so the two <Path> shapes are
         re-expressed with directly-registered shapes that give the identical resting visual —
           - the blue diagonal Path "M100 100 200 200"  -> a blue Line (100,100)->(200,200), thickness 5;
           - the yellow EllipseGeometry (center 150,150, r 50) fill  -> an Ellipse (100x100, centered).
         (The Grids' Margin=12 is kept; HorizontalOptions=Start is kept.) -->
    <StackLayout>
        <Grid HorizontalOptions="Start" BackgroundColor="Beige" WidthRequest="250" HeightRequest="250" Margin="12">
            <Line X1="100" Y1="100" X2="200" Y2="200" Stroke="Blue" StrokeThickness="5" Opacity="0.5" />
            <Line X1="100" Y1="100" X2="200" Y2="200" Stroke="Red" StrokeThickness="20" Opacity="0.5" />
            <Polygon Points="100,100 200,100 100,200" Fill="Green" Opacity="0.5" />
            <Ellipse Fill="Yellow" Opacity="0.5" WidthRequest="100" HeightRequest="100" />
        </Grid>
        <Grid HorizontalOptions="Start" BackgroundColor="Beige" WidthRequest="250" HeightRequest="250" Margin="12">
            <Line X1="100" Y1="100" X2="200" Y2="200" Stroke="Red" />
            <Line X1="0" Y1="0" X2="100" Y2="100" Stroke="Blue" />
            <Line X1="100" Y1="0" X2="100" Y2="100" Stroke="Green" />
        </Grid>
    </StackLayout>
</ContentPage>
