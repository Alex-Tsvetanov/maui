<?xml version="1.0" encoding="utf-8"?>
<!-- Isolation stub: <clear/> discards the dotnet/maui repo's NuGet.config feeds (which point at repo/CI
     package sources) so the MauiReference app restores the pinned public MauiVersion from nuget.org only —
     hermetic, reproducible on any machine. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
