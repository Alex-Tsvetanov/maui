<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MauiReference.app"/>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- PerMonitorV2 matters for the parity board, not just for looks: a DPI-VIRTUALISED process is
           lied to about its own window size, so GetWindowRect reports scaled logical pixels while the
           capture comes back at physical size. The guest agent declares the same awareness, and both
           sides must agree or every Windows capture is silently the wrong scale.
           (dpiAwareness is the modern key; dpiAware is kept for pre-1607 hosts.) -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
    </windowsSettings>
  </application>
</assembly>
