<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-ios;net10.0-maccatalyst;net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>MauiReference</RootNamespace>
		<UseMaui>true</UseMaui>
		<!-- Parity baseline pinned to the stable MAUI 10.0.71 release (the C# oracle version the whole
		     E2E loop compares against — see port/maui-reference/docs/VERIFICATION_LOOP.md). Overrides the
		     workload-default MauiVersion. -->
		<MauiVersion>10.0.71</MauiVersion>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- The installed .NET iOS SDK band (26.5) hard-errors when the host Xcode's major.minor differs
		     (E0191). Xcode 26.6 is a newer minor on this machine and simulator builds work fine with it, so
		     disable the strict equality check instead of pinning a side-by-side Xcode 26.5 install. -->
		<ValidateXcodeVersion>false</ValidateXcodeVersion>

		<!-- Display name -->
		<ApplicationTitle>MauiReference</ApplicationTitle>

		<!-- App Identifier — no hyphens: must be a valid Android package name AND Apple bundle id. -->
		<ApplicationId>dev.mauicpp.mauireference</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Embed assemblies so a plain `adb install -r <apk>` is self-contained (no Fast Deployment
		     sidecar) — required by the capture pipeline, which installs the APK directly. -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidFastDeploymentType></AndroidFastDeploymentType>
	</PropertyGroup>

	<ItemGroup>
		<!-- THE canonical shared XAML pages live OUTSIDE the project dir in ../pages/ — the same files are
		     #embed-ded by the C++ port's gallery_xaml app. XamlC keys each generated partial off the file's
		     x:Class (snake_case filenames are fine); Link places them under Pages/ in-project. Code-behind
		     partials live in Pages/<Pascal>Page.xaml.cs (generated by port/tools/e2e/e2e.py gen). -->
		<MauiXaml Include="..\pages\*.xaml" Link="Pages\%(Filename).xaml" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon — required so Android's AndroidManifest.xml @mipmap/appicon references resolve.
		     Icon/splash are app chrome, NOT captured content, so this does not affect parity captures. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
