filters:
  and:
    - 'file.hasTag("api")'
    - 'note.namespace == "Microsoft.Maui.Controls"'
views:
  - type: cards
    name: "Controls"
    filters:
      and:
        - 'file.hasTag("kind/class")'
    order:
      - file.name
      - kind
  - type: table
    name: "All Controls types"
    order:
      - file.name
      - kind
