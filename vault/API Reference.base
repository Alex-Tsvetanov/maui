filters:
  and:
    - 'file.hasTag("api")'
properties:
  note.kind:
    displayName: "Kind"
  note.namespace:
    displayName: "Namespace"
  note.member_kind:
    displayName: "Member"
views:
  - type: table
    name: "All types"
    filters:
      and:
        - 'file.hasTag("kind/class") || file.hasTag("kind/interface") || file.hasTag("kind/struct") || file.hasTag("kind/enum")'
    order:
      - file.name
      - namespace
      - kind
    groupBy:
      property: namespace
      direction: ASC
  - type: table
    name: "Members"
    filters:
      and:
        - 'note.member_kind'
    order:
      - file.name
      - declaring_type
      - member_kind
